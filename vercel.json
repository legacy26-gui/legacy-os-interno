{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/meta/varrer",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/alertas/rodar",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/estoque/ler",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/estoque/ler",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/estoque/fipe",
      "schedule": "30 12,18 * * *"
    },
    {
      "path": "/api/financeiro/avisos",
      "schedule": "20 11 * * *"
    },
    {
      "path": "/api/tarefas/rodar?hora=manha",
      "schedule": "30 11 * * 1-6"
    },
    {
      "path": "/api/tarefas/rodar?hora=tarde",
      "schedule": "0 20 * * 1-6"
    },
    {
      "path": "/api/relatorios/mandar",
      "schedule": "*/5 11-12 * * 1"
    }
  ]
}
