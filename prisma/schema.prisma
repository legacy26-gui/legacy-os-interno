  reviewerId String?
  reviewer   User?    @relation("DailyReviewer", fields: [reviewerId], references: [id])

  checkedBalance          Boolean @default(false)
  checkedDailyBudget      Boolean @default(false)
  checkedTodaySpend       Boolean @default(false)
  checkedBillingLimit     Boolean @default(false)
  checkedPendingPayments  Boolean @default(false)
  checkedWhatsappResolved Boolean @default(false)

  photoUrl String? @db.Text // foto da campanha (obrigatória no formulário)

  notes     String?  @db.Text
