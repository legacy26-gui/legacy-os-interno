// ─── Painel Comercial (vendas e churn) ──────────────────────────────────────

enum CommercialEventType {
  VENDA
  CHURN
}

// Registro histórico de venda/churn, gerado automaticamente ao criar,
// cancelar ou excluir um cliente — não depende do registro do Client
// continuar existindo (guarda o nome e valor no momento do evento).
model CommercialEvent {
  id          String              @id @default(cuid())
  empresa     Empresa             @default(AGENCIA)
  type        CommercialEventType
  companyName String
  value       Decimal             @db.Decimal(12, 2)
  // Venda que nasceu de um lead do quadro. Serve pra não lançar a mesma venda
  // duas vezes: fechou o cartão, o evento aparece sozinho aqui.
  leadId      String?             @unique
  lead        Lead?               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())

  @@index([empresa, type, createdAt])
  @@map("commercial_events")
}

// ─── Formulário de entrada de novos clientes ────────────────────────────────

enum OnboardingStatus {
  NOVO
  EM_ANDAMENTO
  CONCLUIDO
}

// Resposta do formulário público que o cliente novo preenche antes de entrar
// na operação. Os campos que a equipe usa pra listar e buscar ficam em coluna
// própria; o resto das respostas fica em JSON, porque as perguntas mudam com o
// tempo e não vale uma migration a cada ajuste de pergunta.
model ClientOnboarding {
  id            String           @id @default(cuid())
  companyName   String
  contactName   String
  phone         String?
  email         String?
  city          String?
  answers       Json
  // Dados digitais coletados fora do formulário (Instagram, Google, site...).
  // Ver src/lib/ai/enriquecimento.ts — hoje nasce nulo, a estrutura já existe.
  enrichment    Json?
  // Resumo/transcrição da reunião de onboarding. Alimenta o plano de ação final.
  meetingNotes  String?          @db.Text
  status        OnboardingStatus @default(NOVO)
  internalNotes String?
  clientId      String?
  client        Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  analyses      OnboardingAnalysis[]
  etapas        OnboardingEtapa[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, createdAt])
  @@map("client_onboardings")
}

// Uma etapa de implantação marcada como feita, numa ficha.
//
// Só existe linha pro que FOI feito: a lista das etapas possíveis mora no
// código (src/lib/etapas-implantacao.ts), não no banco. Assim mexer na lista
// — tirar, acrescentar, renomear — não exige migração nem mexe em ficha
// nenhuma, e a marcação antiga continua guardada caso a etapa volte.
model OnboardingEtapa {
  id           String           @id @default(cuid())
  onboardingId String
  onboarding   ClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  // A chave da etapa, como está em ETAPAS. Texto livre de propósito: se a
  // lista mudar, o banco não precisa saber.
  chave        String
  concluidoEm  DateTime         @default(now())
  // Quem marcou. Vira nulo se a pessoa sair do sistema — a etapa continua
  // feita, só perde o nome de quem fez.
  concluidoPorId String?
  concluidoPor   User?          @relation("EtapaConcluida", fields: [concluidoPorId], references: [id], onDelete: SetNull)
  observacao   String?

  // Uma marcação por etapa por ficha: clicar duas vezes não duplica.
  @@unique([onboardingId, chave])
  @@map("onboarding_etapas")
}

// ─── Diagnóstico gerado por IA ──────────────────────────────────────────────

enum AnalysisKind {
  PRE_DIAGNOSTICO // antes da reunião: formulário (+ dados digitais quando houver)
  PLANO_FINAL     // depois da reunião: soma o que foi levantado na conversa
}

enum AnalysisStatus {
  PROCESSANDO
  CONCLUIDO
  ERRO
}

// Cada geração vira uma linha nova — nada é sobrescrito. A tela mostra a última
// versão concluída de cada tipo e o histórico continua no banco pra auditoria.
model OnboardingAnalysis {
  id            String           @id @default(cuid())
  onboardingId  String
  onboarding    ClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  // Repetido aqui pra conseguir buscar o diagnóstico direto pelo cliente depois
  // que a ficha vira cadastro.
  clientId      String?
  kind          AnalysisKind     @default(PRE_DIAGNOSTICO)
  version       Int              @default(1)
  status        AnalysisStatus   @default(PROCESSANDO)
  provider      String
  model         String
  promptVersion String
  // Exatamente o que foi enviado pra IA (respostas + dados digitais + reunião).
  inputData     Json
  result        Json?
  rawResponse   String?          @db.Text
  error         String?          @db.Text
  // Id do trabalho no provedor quando a geração roda em segundo plano (a função
  // da Vercel morre em 60s; uma ficha cheia leva mais que isso). A tela pergunta
  // pelo resultado até ficar pronto.
  providerJobId String?
  durationMs    Int?
  requestedById String?
  createdAt     DateTime         @default(now())
  completedAt   DateTime?

  @@index([onboardingId, kind, version])
  @@index([clientId])
  @@map("onboarding_analyses")
}

// ───────────────────────────── Meta Ads ────────────────────────────────────
//
// As contas de anúncio do cliente na Meta, e o que o sistema puxa delas.
//
// Até aqui o que existia da Meta era só de saída: a Conversions API contando
// pra ela o que aconteceu com o lead (ver src/lib/meta-capi.ts). Estas
// tabelas são o caminho contrário — o que a Meta tem a dizer de volta.
//
// Nada disto encosta em `campaigns`, que continua sendo o número digitado à
// mão: são duas origens diferentes pro mesmo assunto, e misturá-las faria
// ninguém saber mais qual número veio de onde.

/** Uma conta de anúncio. Um cliente pode ter mais de uma. */
model MetaAdAccount {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  // O id da conta lá na Meta (act_...). Único no sistema inteiro: a mesma
  // conta pendurada em dois clientes duplicaria gasto e lead no relatório.
  metaAccountId  String   @unique
  name           String?
  // Conta pré-paga: o saldo acaba e o anúncio para sem avisar ninguém.
  isPrepay       Boolean  @default(false)
  // Qual ação da Meta conta como "lead" nesta conta. Varia por cliente —
  // conversa iniciada no WhatsApp não é o mesmo que formulário preenchido.
  leadActionType String   @default("onsite_conversion.messaging_conversation_started_7d")
  active         Boolean  @default(true)
  lastSyncedAt   DateTime?
  // O erro da última tentativa, pra a falha aparecer na tela em vez de só no
  // log — sincronização que falha calada vira número velho passando por novo.
  lastSyncError  String?
  createdAt      DateTime @default(now())

  balanceSnapshots BalanceSnapshot[]
  adsetInsights    AdsetInsightDaily[]

  @@index([clientId])
  @@map("meta_ad_accounts")
}

/**
 * O saldo da conta pré-paga, fotografado a cada sincronização.
 *
 * É histórico e não campo único de propósito: o que interessa não é só
 * quanto tem agora, é a queda — dá pra prever em quantos dias acaba.
 *
 * Em centavos (Int), não em decimal: dinheiro em ponto flutuante perde
 * centavo em conta, e a Meta já devolve inteiro.
 */
model BalanceSnapshot {
  id             String        @id @default(cuid())
  adAccountId    String
  adAccount      MetaAdAccount @relation(fields: [adAccountId], references: [id])
  availableCents Int
  capturedAt     DateTime      @default(now())

  @@index([adAccountId, capturedAt(sort: Desc)])
  @@map("balance_snapshots")
}

/**
 * O resultado de cada conjunto de anúncios, por dia.
 *
 * A chave única (conta + conjunto + dia) é o que deixa a sincronização ser
 * repetida à vontade: puxar o mesmo dia duas vezes atualiza a linha em vez de
 * duplicar o gasto.
 */
model AdsetInsightDaily {
  id          String        @id @default(cuid())
  adAccountId String
  adAccount   MetaAdAccount @relation(fields: [adAccountId], references: [id])
  adsetId     String
  adsetName   String
  campaignId  String?
  // Só a data, sem hora: o dado da Meta é fechado por dia.
  date        DateTime      @db.Date
  spendCents  Int
  impressions Int
  clicks      Int
  linkClicks  Int
  leads       Int

  @@unique([adAccountId, adsetId, date])
  @@index([adAccountId, date])
  @@map("adset_insights_daily")
}
