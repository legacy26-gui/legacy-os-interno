# Postgres connection string (Vercel Postgres/Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Random secret used to sign session JWTs. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Secret key required to call GET /api/setup?key=... (one-time initial seed: admin users + contract templates)
SETUP_SECRET=""

# ─── IA (diagnóstico automático das fichas de novos clientes) ───────────────
# Escolha o provedor e preencha SÓ a chave dele. Sem chave o formulário continua
# funcionando: a ficha é salva e a análise fica registrada com erro, pra ser
# gerada depois.
AI_PROVIDER="openai"          # openai | anthropic
OPENAI_API_KEY=""             # quando AI_PROVIDER=openai
# ANTHROPIC_API_KEY=""        # quando AI_PROVIDER=anthropic

# Opcionais — só mexa se precisar. Valores abaixo são os padrões.
# AI_MODEL="gpt-5"            # padrão por provedor: gpt-5 (openai) / claude-opus-5 (anthropic)
#                             # veja os modelos da sua conta em:
#                             # /api/diagnostico/gerar?key=SETUP_SECRET&modelos=1
# AI_EFFORT="medium"        # só usado pela Anthropic: low | medium | high | xhigh | max
# AI_MAX_TOKENS="8000"
# AI_TIMEOUT_MS="52000"     # abaixo do limite de execução da função na Vercel
# AI_MAX_RETRIES="0"        # repetição automática; o botão "Regenerar" é a retentativa manual

# ─── Lead da landing (POST /api/publico/leads) ──────────────────────────────
# Opcional. Sem isso o lead é salvo normalmente e o aviso sai só no log da
# Vercel. Com uma URL aqui, cada lead novo também vai num POST pra ela — serve
# pra plugar Zapier, Make ou API de WhatsApp sem mexer no código.
# LEAD_WEBHOOK_URL=""

# ─── Aviso de lead novo no celular (push do PWA) ────────────────────────────
# Gere o par uma vez em: /api/push/chaves?key=SETUP_SECRET&gerar=1
# Sem isso o lead é salvo normalmente, só não sai notificação.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@legacydigital.com"
