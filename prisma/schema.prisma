  createdAt  DateTime @default(now())

  @@map("vacations")
}

// ─── Marketing / Conteúdo ───────────────────────────────────────────────────

enum ContentStatus {
  IDEIA
  PRODUCAO
  APROVACAO
  PUBLICADO
}

model ContentItem {
  id            String        @id @default(cuid())
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  platforms     String[]
  scheduledDate DateTime?
  status        ContentStatus @default(IDEIA)
  mediaUrl      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("content_items")
}

// ─── Gravação de vídeos ─────────────────────────────────────────────────────

// Uma ida de gravação: a loja, a hora e quantos vídeos saíram dali.
//
// Existe porque o controle disso vivia na cabeça de quem gravou. O que a
// equipe precisa responder é: o que foi gravado hoje, quantos vídeos, e o que
// vence pra entregar amanhã.
//
// O prazo é D+1 — gravou hoje, entrega amanhã. Por isso `entregaEm` é um
// campo, e não uma conta feita na hora de mostrar: o padrão é um dia depois,
// mas prazo combinado diferente com a loja tem que poder ser escrito.
model Gravacao {
  id         String    @id @default(cuid())
  empresa    Empresa   @default(AGENCIA)
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // O nome da loja fica guardado aqui mesmo com cliente vinculado, igual aos
  // eventos de venda: se o cliente for renomeado ou sair da carteira, a
  // gravação continua dizendo pra quem foi. É também o campo de quem grava
  // pra loja que ainda não está cadastrada.
  loja       String
  // Quantos vídeos saíram dessa gravação.
  quantidade Int       @default(1)
  // Dia e hora da gravação — a hora importa porque num dia há mais de uma.
  gravadoEm  DateTime
  // Quando tem que estar entregue. Nasce como gravadoEm + 1 dia.
  entregaEm  DateTime
  // Preenchido quando a entrega sai de verdade. Vazio = ainda devendo.
  entregueEm DateTime?
  observacao String?   @db.Text

  // Quem registrou. Não é "quem gravou" — é o rastro de quem lançou na tela.
  ownerId String?
  owner   User?   @relation("GravacaoRegistrada", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresa, gravadoEm])
  @@index([empresa, entregaEm])
  @@map("gravacoes")
}

// ─── Suporte aos clientes ───────────────────────────────────────────────────

enum TicketStatus {
  ABERTO
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  RESOLVIDO
}

model SupportTicket {
  id          String       @id @default(cuid())
  clientId    String
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subject     String
  description String?
  priority    TaskPriority @default(MEDIA)
  status      TicketStatus @default(ABERTO)
  assigneeId  String?
  assignee    User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("support_tickets")
}

// ─── Metas da agência ───────────────────────────────────────────────────────

// Saldo de caixa informado manualmente: o sistema não lê o extrato do banco,
// então o acumulado do DFC parte deste valor. Linha única (id fixo "default").
// openingDate é a data exata em que o saldo foi conferido — só entradas e
// saídas posteriores a ela mexem no saldo (as anteriores já estão dentro dele).
model CashSetting {
  id             String   @id @default("default")
  // Saldo inicial é por empresa: o caixa do treinamentos não começa com o
  // dinheiro da agência. Uma linha por empresa, por isso o @unique.
  empresa        Empresa  @unique @default(AGENCIA)
  openingBalance Decimal  @db.Decimal(12, 2)
  openingDate    DateTime @db.Date
  updatedAt      DateTime @updatedAt

  @@map("cash_settings")
}

model MonthlyGoal {
  id               String   @id @default(cuid())
  empresa          Empresa  @default(AGENCIA)
  month            String // YYYY-MM
  targetRevenue    Decimal  @db.Decimal(12, 2)
  targetSalesQty   Int?
  targetSalesValue Decimal? @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Cada empresa tem a meta dela pro mesmo mês — a agência pode querer 50 mil
  // em outubro e o treinamentos 12 mil, e as duas linhas convivem.
  @@unique([empresa, month])
  @@map("monthly_goals")
}

// ─── Gestão de Contas (agências de tráfego) ─────────────────────────────────

model DailyReview {
  id         String  @id @default(cuid())
  clientId   String
  client     Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reviewerId String?
  reviewer   User?   @relation("DailyReviewer", fields: [reviewerId], references: [id])

  checkedBalance          Boolean @default(false)
  checkedDailyBudget      Boolean @default(false)
  checkedTodaySpend       Boolean @default(false)
  checkedBillingLimit     Boolean @default(false)
  checkedPendingPayments  Boolean @default(false)
  checkedWhatsappResolved Boolean @default(false)

  photoUrl String? @db.Text // foto da campanha (obrigatória no formulário)

  notes     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@map("daily_reviews")
}

model WeeklyReview {
  id         String  @id @default(cuid())
  clientId   String
  client     Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reviewerId String?
  reviewer   User?   @relation("WeeklyReviewer", fields: [reviewerId], references: [id])

  // Semana do mês (1 a 5) e mês de referência (AAAA-MM) a que a revisão se
  // refere. Guardados explicitamente pra que preencher com atraso — inclusive
  // depois de virar o mês — não jogue a revisão na semana errada.
  weekOfMonth Int?
  refMonth    String?

  paymentCleared       Boolean @default(false)
  reportGenerated      Boolean @default(false)
  checkedBestCampaigns Boolean @default(false)
  checkedWeeklyCost    Boolean @default(false)
  definedNewCreatives  Boolean @default(false)
  definedNewCampaigns  Boolean @default(false)

  reportPhotoUrl String? @db.Text // foto do relatório (obrigatória no formulário)

  notes     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@map("weekly_reviews")
}

enum CampaignChangeType {
  CAMPANHA_CRIADA
  CAMPANHA_PAUSADA
  CRIATIVO_ALTERADO
  CRIATIVO_NOVO
  PUBLICO_ALTERADO
  ORCAMENTO_ALTERADO
  OUTRO
}

model CampaignChange {
  id            String             @id @default(cuid())
  clientId      String
  client        Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  responsibleId String?
  responsible   User?              @relation("ChangeResponsible", fields: [responsibleId], references: [id])
  type          CampaignChangeType
  description   String?
  createdAt     DateTime           @default(now())

  @@index([clientId, createdAt])
  @@map("campaign_changes")
}

// ─── Playbooks (base de conhecimento interna) ───────────────────────────────

model Playbook {
  id        String   @id @default(cuid())
  title     String
  tags      String[] @default([])
  content   String   @db.Text
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tags])
  @@map("playbooks")
}

// ─── Painel Comercial (vendas e churn) ──────────────────────────────────────

enum CommercialEventType {
  VENDA
  CHURN
}

// Registro histórico de venda/churn, gerado automaticamente ao criar,
// cancelar ou excluir um cliente — não depende do registro do Client
// continuar existindo (guarda o nome e valor no momento do evento).
model CommercialEvent {
  id          String              @id @default(cuid())
  empresa     Empresa             @default(AGENCIA)
  type        CommercialEventType
  companyName String
  value       Decimal             @db.Decimal(12, 2)
  // Venda que nasceu de um lead do quadro. Serve pra não lançar a mesma venda
  // duas vezes: fechou o cartão, o evento aparece sozinho aqui.
  leadId      String?             @unique
  lead        Lead?               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())

  @@index([empresa, type, createdAt])
  @@map("commercial_events")
}

// ─── Formulário de entrada de novos clientes ────────────────────────────────

enum OnboardingStatus {
  NOVO
  EM_ANDAMENTO
  CONCLUIDO
}

// Resposta do formulário público que o cliente novo preenche antes de entrar
// na operação. Os campos que a equipe usa pra listar e buscar ficam em coluna
// própria; o resto das respostas fica em JSON, porque as perguntas mudam com o
// tempo e não vale uma migration a cada ajuste de pergunta.
model ClientOnboarding {
  id            String               @id @default(cuid())
  companyName   String
  contactName   String
  phone         String?
  email         String?
  city          String?
  answers       Json
  // Dados digitais coletados fora do formulário (Instagram, Google, site...).
  // Ver src/lib/ai/enriquecimento.ts — hoje nasce nulo, a estrutura já existe.
  enrichment    Json?
  // Resumo/transcrição da reunião de onboarding. Alimenta o plano de ação final.
  meetingNotes  String?              @db.Text
  status        OnboardingStatus     @default(NOVO)
  internalNotes String?
  clientId      String?
  client        Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  analyses      OnboardingAnalysis[]
  etapas        OnboardingEtapa[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status, createdAt])
  @@map("client_onboardings")
}

// Uma etapa de implantação marcada como feita, numa ficha.
//
// Só existe linha pro que FOI feito: a lista das etapas possíveis mora no
// código (src/lib/etapas-implantacao.ts), não no banco. Assim mexer na lista
// — tirar, acrescentar, renomear — não exige migração nem mexe em ficha
// nenhuma, e a marcação antiga continua guardada caso a etapa volte.
model OnboardingEtapa {
  id             String           @id @default(cuid())
  onboardingId   String
  onboarding     ClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  // A chave da etapa, como está em ETAPAS. Texto livre de propósito: se a
  // lista mudar, o banco não precisa saber.
  chave          String
  concluidoEm    DateTime         @default(now())
  // Quem marcou. Vira nulo se a pessoa sair do sistema — a etapa continua
  // feita, só perde o nome de quem fez.
  concluidoPorId String?
  concluidoPor   User?            @relation("EtapaConcluida", fields: [concluidoPorId], references: [id], onDelete: SetNull)
  observacao     String?

  // Uma marcação por etapa por ficha: clicar duas vezes não duplica.
  @@unique([onboardingId, chave])
  @@map("onboarding_etapas")
}

// ─── Diagnóstico gerado por IA ──────────────────────────────────────────────

enum AnalysisKind {
  PRE_DIAGNOSTICO // antes da reunião: formulário (+ dados digitais quando houver)
  PLANO_FINAL // depois da reunião: soma o que foi levantado na conversa
}

enum AnalysisStatus {
  PROCESSANDO
  CONCLUIDO
  ERRO
}

// Cada geração vira uma linha nova — nada é sobrescrito. A tela mostra a última
// versão concluída de cada tipo e o histórico continua no banco pra auditoria.
model OnboardingAnalysis {
  id            String           @id @default(cuid())
  onboardingId  String
  onboarding    ClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  // Repetido aqui pra conseguir buscar o diagnóstico direto pelo cliente depois
  // que a ficha vira cadastro.
  clientId      String?
  kind          AnalysisKind     @default(PRE_DIAGNOSTICO)
  version       Int              @default(1)
  status        AnalysisStatus   @default(PROCESSANDO)
  provider      String
  model         String
  promptVersion String
  // Exatamente o que foi enviado pra IA (respostas + dados digitais + reunião).
  inputData     Json
  result        Json?
  rawResponse   String?          @db.Text
  error         String?          @db.Text
  // Id do trabalho no provedor quando a geração roda em segundo plano (a função
  // da Vercel morre em 60s; uma ficha cheia leva mais que isso). A tela pergunta
  // pelo resultado até ficar pronto.
  providerJobId String?
  durationMs    Int?
  requestedById String?
  createdAt     DateTime         @default(now())
  completedAt   DateTime?

  @@index([onboardingId, kind, version])
  @@index([clientId])
  @@map("onboarding_analyses")
}

// ───────────────────────────── Meta Ads ────────────────────────────────────
//
// As contas de anúncio do cliente na Meta, e o que o sistema puxa delas.
//
// Até aqui o que existia da Meta era só de saída: a Conversions API contando
// pra ela o que aconteceu com o lead (ver src/lib/meta-capi.ts). Estas
// tabelas são o caminho contrário — o que a Meta tem a dizer de volta.
//
// Nada disto encosta em `campaigns`, que continua sendo o número digitado à
// mão: são duas origens diferentes pro mesmo assunto, e misturá-las faria
// ninguém saber mais qual número veio de onde.

/**
 * Uma conta de anúncio. Um cliente pode ter mais de uma.
 */
model MetaAdAccount {
  id             String    @id @default(cuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  // O id da conta lá na Meta (act_...). Único no sistema inteiro: a mesma
  // conta pendurada em dois clientes duplicaria gasto e lead no relatório.
  metaAccountId  String    @unique
  name           String?
  // Conta pré-paga: o saldo acaba e o anúncio para sem avisar ninguém.
  isPrepay       Boolean   @default(false)
  // Qual ação da Meta conta como "lead" nesta conta. Varia por cliente —
  // conversa iniciada no WhatsApp não é o mesmo que formulário preenchido.
  leadActionType String    @default("onsite_conversion.messaging_conversation_started_7d")
  active         Boolean   @default(true)
  lastSyncedAt   DateTime?
  // O erro da última tentativa, pra a falha aparecer na tela em vez de só no
  // log — sincronização que falha calada vira número velho passando por novo.
  lastSyncError  String?

  /// Que ações a Meta devolveu nesta conta na última varredura, e quantas.
  ///
  /// Guardado pra responder uma pergunta que antes não tinha resposta: "o
  /// resultado está zerado porque a loja não vendeu, ou porque o tipo
  /// configurado é o errado?". Sem isto os dois casos são o mesmo zero na
  /// tela, e o segundo passa meses sem ninguém perceber.
  ///
  /// Formato: { "offsite_conversion.fb_pixel_purchase": 412, "link_click": 9800 }
  acoesVistas Json?
  createdAt   DateTime @default(now())

  balanceSnapshots BalanceSnapshot[]
  insights         MetaInsightDaily[]
  lifetime         MetaLifetime[]
  criativos        MetaAdCreative[]
  campanhas        MetaCampaign[]
  conjuntos        MetaAdset[]

  @@index([clientId])
  @@map("meta_ad_accounts")
}

/**
 * O saldo da conta pré-paga, fotografado a cada sincronização.
 * É histórico e não campo único de propósito: o que interessa não é só
 * quanto tem agora, é a queda — dá pra prever em quantos dias acaba.
 * Em centavos (Int), não em decimal: dinheiro em ponto flutuante perde
 * centavo em conta, e a Meta já devolve inteiro.
 */
model BalanceSnapshot {
  id             String        @id @default(cuid())
  adAccountId    String
  adAccount      MetaAdAccount @relation(fields: [adAccountId], references: [id])
  availableCents Int
  capturedAt     DateTime      @default(now())

  @@index([adAccountId, capturedAt(sort: Desc)])
  @@map("balance_snapshots")
}

/**
 * O resultado de cada conjunto de anúncios, por dia.
 * A chave única (conta + conjunto + dia) é o que deixa a sincronização ser
 * repetida à vontade: puxar o mesmo dia duas vezes atualiza a linha em vez de
 * duplicar o gasto.
 */
model MetaInsightDaily {
  id          String        @id @default(cuid())
  adAccountId String
  adAccount   MetaAdAccount @relation(fields: [adAccountId], references: [id])

  // O grão é o ANÚNCIO, o mais fino que a Meta entrega. Conjunto e campanha
  // saem somando daqui — e nunca o contrário: total não se desfaz. Guardar
  // por conjunto, como era antes, tornava a tela de anúncios impossível sem
  // refazer a busca inteira.
  adId         String
  adName       String
  adsetId      String
  adsetName    String
  campaignId   String?
  // Nome guardado junto do número: campanha renomeada ou apagada deixaria o
  // histórico sem nome, e relatório sem nome não se lê.
  campaignName String?

  // Só a data, sem hora: o dado da Meta é fechado por dia.
  date        DateTime @db.Date
  spendCents  Int
  impressions Int
  // Quantas PESSOAS viram, contra impressions que conta vezes. A mesma
  // pessoa vendo três vezes é 3 impressões e 1 de alcance.
  reach       Int      @default(0)
  clicks      Int
  linkClicks  Int
  leads       Int

  @@unique([adAccountId, adId, date])
  @@index([adAccountId, date])
  @@index([adAccountId, campaignId, date])
  @@map("meta_insights_daily")
}

// O acumulado de vida inteira, por anúncio.
//
// Tabela separada da diária porque a pergunta é outra: a diária responde "o
// que aconteceu nestes 7 dias" e a Meta a reprocessa; esta responde "quanto
// essa campanha já consumiu desde que nasceu", e para isso guardar dia a dia
// o histórico inteiro seria anos de linha pra somar sempre tudo.
//
// É um retrato, não um histórico: cada busca substitui o número anterior.
model MetaLifetime {
  id          String        @id @default(cuid())
  adAccountId String
  adAccount   MetaAdAccount @relation(fields: [adAccountId], references: [id])

  adId         String
  adName       String
  adsetId      String
  adsetName    String
  campaignId   String?
  campaignName String?

  spendCents   Int
  impressions  Int
  reach        Int       @default(0)
  clicks       Int
  linkClicks   Int
  leads        Int
  // Desde quando a Meta contou. Ela devolve junto, e sem isso "vida inteira"
  // é uma palavra sem data.
  desde        DateTime? @db.Date
  ate          DateTime? @db.Date
  atualizadoEm DateTime  @default(now())

  @@unique([adAccountId, adId])
  @@index([adAccountId, campaignId])
  @@map("meta_lifetime")
}

// O criativo do anúncio: a miniatura e o link pra ver inteiro.
//
// Tabela separada das duas de números porque muda numa frequência
// completamente outra: número muda todo dia, criativo muda quando alguém
// troca a arte. E porque a miniatura é um endereço na CDN da Meta, que
// expira — guardar junto do número faria a linha de ontem carregar uma imagem
// quebrada de hoje.
// A campanha como CADASTRO: nome, se está ligada e quanto pode gastar.
//
// Separado das tabelas de número porque muda por outro motivo: número muda
// todo dia sozinho, isto muda quando alguém mexe. E porque a tela precisa
// mostrar campanha que existe mas não gastou nada no período — essa não
// aparece em lugar nenhum nos insights.
model MetaCampaign {
  id          String        @id @default(cuid())
  adAccountId String
  adAccount   MetaAdAccount @relation(fields: [adAccountId], references: [id])

  campaignId      String
  name            String
  // Como a Meta escreve: ACTIVE, PAUSED, ARCHIVED, DELETED.
  status          String?
  // O status DE VERDADE, já considerando o pai e os limites da conta. Uma
  // campanha ACTIVE dentro de conta sem saldo entrega nada, e é isto que
  // conta essa história.
  effectiveStatus String?
  objective       String?

  // Em centavos, como a Meta já devolve. Uma das duas, nunca as duas.
  dailyBudgetCents    Int?
  lifetimeBudgetCents Int?

  atualizadoEm DateTime @default(now())

  @@unique([adAccountId, campaignId])
  @@map("meta_campaigns")
}

// O conjunto como cadastro. Mesma ideia da campanha.
model MetaAdset {
  id          String        @id @default(cuid())
  adAccountId String
  adAccount   MetaAdAccount @relation(fields: [adAccountId], references: [id])

  adsetId         String
  campaignId      String?
  name            String
  status          String?
  effectiveStatus String?

  dailyBudgetCents    Int?
  lifetimeBudgetCents Int?

  atualizadoEm DateTime @default(now())

  @@unique([adAccountId, adsetId])
  @@index([adAccountId, campaignId])
  @@map("meta_adsets")
}

model MetaAdCreative {
  id          String        @id @default(cuid())
  adAccountId String
  adAccount   MetaAdAccount @relation(fields: [adAccountId], references: [id])

  adId            String
  adName          String
  // ACTIVE, PAUSED, etc. — como a Meta escreve. Guardado como veio, sem
  // traduzir: traduzir aqui é inventar um vocabulário nosso em cima do dela.
  status          String?
  // O status já considerando campanha e conjunto acima dele.
  effectiveStatus String?
  adsetId         String?
  campaignId      String?

  // Endereço da miniatura na CDN da Meta. Pode expirar, e a tela trata isso.
  thumbnailUrl String?
  // O link de pré-visualização que a Meta gera: é o "ver o anúncio" dela.
  previewUrl   String?

  // ── O texto do anúncio, e o post onde mora a prova social ──────────────
  //
  // Guardados pra duas coisas: mostrar a legenda atual na tela (hoje ela só
  // existe dentro do Gerenciador) e tornar possível editar — editar exige
  // ler o que está escrito antes de escrever o novo.
  //
  // `postId` é o `effective_object_story_id`: o post onde moram as curtidas
  // e os comentários. É ele que responde à pergunta que ninguém respondeu
  // ainda: editar o texto de um anúncio troca o post, e com ele zera a prova
  // social? Guardando o id a cada passada, a primeira edição real responde
  // com dado nosso em vez de opinião.
  creativeId String?
  legenda    String? @db.Text
  titulo     String?
  descricao  String? @db.Text
  postId     String?

  atualizadoEm DateTime @default(now())

  @@unique([adAccountId, adId])
  @@map("meta_ad_creatives")
}

/// Cada passo do robô de WhatsApp atendendo uma mensagem.
///
/// ── Por que isto precisou existir ─────────────────────────────────────────
///
/// Porque o robô ficou mudo no grupo da R2 e eu não tinha NADA pra olhar.
/// A mensagem chegava, a rota respondia "recebido", e o atendimento — que
/// roda depois da resposta HTTP — decidia em silêncio. Pior: três `catch`
/// vazios no caminho (a rota, o `responder()` e o aviso à equipe) jogavam
/// qualquer erro no lixo, e o `responder()` ainda ignorava o retorno do
/// envio. A Z-API podia estar RECUSANDO falar no grupo e o sistema registrava
/// sucesso.
///
/// Cada investigação virava uma ida e volta pedindo print pra quem estava do
/// outro lado. Agora cada decisão deixa uma linha aqui, e a próxima mensagem
/// que chegar explica sozinha o que aconteceu com ela.
///
/// ── O que NÃO entra aqui ──────────────────────────────────────────────────
///
/// Texto de mensagem de cliente. O `detalhe` guarda nome de anúncio, contagem
/// e código de erro — nunca a conversa. E passa por uma máscara que apaga
/// sequências que tenham cara de token, porque erro de serviço às vezes
/// devolve a URL que chamou, e na Z-API a URL carrega a credencial.
model PassoDoRobo {
  id     String   @id @default(cuid())
  quando DateTime @default(now())

  /// A mensagem que estava sendo atendida, pra juntar os passos dela.
  messageId String?
  /// O grupo (ou telefone) de onde ela veio.
  de        String?

  /// O nome do passo: "chegou", "sem-mencao", "pausou", "envio-recusado"…
  passo   String
  /// O que mais ajuda a entender aquele passo. Nunca a mensagem do cliente.
  detalhe String?

  @@index([quando])
  @@index([messageId])
  @@map("passo_do_robo")
}

/// O estado da conexão do número do robô (Z-API). Uma linha só.
///
/// Existe porque a Z-API falha calada: o celular desconecta e relatórios, avisos e
/// pausas param sem ninguém saber. Guarda o último estado conhecido pra avisar só
/// quando MUDA (caiu / voltou), e não a cada conferência.
model ConexaoDoWhatsapp {
  id             String   @id @default("zapi")
  conectado      Boolean  @default(true)
  /// Desde quando está no estado atual.
  desde          DateTime @default(now())
  /// Conferências seguidas que acharam desconectado. Só avisa a partir de 2.
  falhasSeguidas Int      @default(0)
  ultimoErro     String?
  conferidoEm    DateTime @default(now())

  @@map("conexao_whatsapp")
}

/// O site da loja de onde o sistema lê o estoque (hoje: AutoCerto). Uma linha por loja.
///
/// O estoque serve à inteligência comercial (há quantos dias o carro está parado, o que
/// entrou, o que saiu). O preço de VENDA continua vindo do anúncio, não daqui.
model EstoqueDaLoja {
  id             String    @id @default(cuid())
  clientId       String    @unique
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteUrl        String
  /// "autocerto" por enquanto: cada sistema de estoque tem um leitor.
  sistema        String    @default("autocerto")
  ultimaLeituraEm DateTime?
  /// Quantos carros a última lista trouxe.
  ultimoTotal    Int?
  /// O que deu errado na última leitura (null = deu certo).
  ultimoErro     String?
  /// O rodapé das legendas (endereço, WhatsApp) — sugerido pelo site e conferido pela pessoa. Ver src/lib/estoque/contato.ts.
  rodapeDaLegenda String?
  criadoEm       DateTime  @default(now())

  @@map("estoque_da_loja")
}

/// Um carro do estoque do site. Nunca é apagado: carro que saiu da lista ganha `sumiuEm`,
/// e a data de entrada é o que permite dizer "parado há 75 dias".
model EstoqueCarro {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// O código do carro no sistema de estoque (no AutoCerto, o número da URL).
  codigo        String
  titulo        String
  marca         String?
  modelo        String?
  versao        String?
  anoModelo     Int?
  anoFabricacao Int?
  cor           String?
  km            Int?
  /// O preço que o SITE mostra. Informativo — a venda usa o preço do anúncio.
  precoCents    Int?
  url           String
  foto          String?
  primeiraVezEm DateTime  @default(now())
  ultimaVezEm   DateTime  @default(now())
  /// Preenchido quando o carro some da lista; volta a null se reaparecer.
  sumiuEm       DateTime?
  /// Quando a página do carro foi lida pela última vez (pra renovar em rodízio).
  detalheEm     DateTime?
  /// A tabela FIPE deste carro (ver src/lib/fipe). "exato": uma versão; "faixa": empate entre versões
  /// parecidas (fipeCents = menor, fipeMaxCents = maior); "nenhum": não achou — e aí não se afirma nada.
  fipeTipo        String?
  fipeCents       Int?
  fipeMaxCents    Int?
  /// O nome da(s) versão(ões) na FIPE, pra quem quiser conferir.
  fipeModelo      String?
  fipeCodigo      String?
  /// O mês da tabela ("novembro de 2026").
  fipeReferencia  String?
  fipeConferidoEm DateTime?
  /// Quando o gestor da loja foi avisado por WhatsApp que este carro novo está sem anúncio (um aviso só por carro).
  avisoNovoEm   DateTime?
  /// O rascunho (pausado) que o "anunciar agora" já subiu pra este carro. "pendente" = subindo neste momento.
  rascunhoAdId  String?
  rascunhoEm    DateTime?
  precos        EstoquePreco[]
  arte          ArteDoCarro?

  @@unique([clientId, codigo])
  @@index([clientId, sumiuEm])
  @@map("estoque_carros")
}

/// Histórico de preço do site: uma linha só quando o preço MUDA.
model EstoquePreco {
  id         String       @id @default(cuid())
  carroId    String
  carro      EstoqueCarro @relation(fields: [carroId], references: [id], onDelete: Cascade)
  precoCents Int
  vistoEm    DateTime     @default(now())

  @@index([carroId, vistoEm])
  @@map("estoque_precos")
}

/// Um anúncio sendo montado pelo WhatsApp: uma conversa por pessoa (quem manda as fotos pro robô no privado).
///
/// Guarda o ponto da conversa (`etapa`) e o que já se decidiu (loja, conjunto, anúncio-base, carro, legenda), pra
/// o robô continuar de onde parou a cada mensagem. Vence sozinho (`venceEm`) e é apagado quando o anúncio sobe ou
/// a pessoa cancela. Ver src/lib/whatsapp/subir-anuncio.ts.
model RascunhoWhatsapp {
  id     String @id @default(cuid())
  userId String @unique

  /// "coletando", "loja", "conjunto", "base", "dados", "legenda" ou "confirmando".
  etapa String

  clientId     String?
  lojaNome     String?
  adsetId      String?
  adsetNome    String?
  campanhaNome String?
  baseAdId     String?
  baseNome     String?
  /// O que se leu do anúncio-base (formato, legenda, título e link).
  base         Json?

  /// Os dados do carro, como a pessoa escreveu (ou do estoque do site).
  carro  String? @db.Text
  nome   String?
  titulo String?
  legenda String? @db.Text
  /// Avisos da conferência da legenda (preço que não está nos dados etc.).
  avisosDaLegenda Json?

  /// A lista numerada que o robô acabou de mostrar: [{ id, rotulo }]. A resposta "2" escolhe o item 2.
  opcoes Json?

  /// Duplicar o conjunto (o escolhido é o molde) em vez de subir dentro dele. Ver PadraoDeRascunho.
  duplicarConjunto Boolean @default(false)
  orcamentoCents   Int?
  /// O conjunto que uma tentativa anterior já criou (e o anúncio falhou depois): a próxima sobe nele.
  conjuntoCriadoId String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  venceEm      DateTime

  @@map("rascunhos_whatsapp")
}

/// As fotos que a pessoa mandou pro robô, guardadas até o anúncio subir (ou vencer).
/// Ficam no banco porque o conjunto — e portanto a conta da Meta onde a foto sobe — só é escolhido depois.
model RascunhoFoto {
  id        String   @id @default(cuid())
  userId    String
  /// O id da mensagem na Z-API: a mesma foto reenviada não entra duas vezes.
  messageId String   @unique
  mime      String
  bytes     Bytes
  criadoEm  DateTime @default(now())

  @@index([userId, criadoEm])
  @@map("rascunho_fotos")
}

/// O conjunto e o anúncio-base que se usou da última vez em cada loja. "Muitas vezes vai subir dentro de um
/// conjunto que já existe": o robô propõe o mesmo de sempre, e a pessoa só confirma ou troca.
model PadraoDeRascunho {
  id           String   @id @default(cuid())
  clientId     String   @unique
  adsetId      String
  baseAdId     String
  /// A loja trabalha "um carro por conjunto": o conjunto acima é o MOLDE, e cada anúncio ganha um conjunto novo.
  duplicarConjunto Boolean @default(false)
  /// O orçamento diário dos conjuntos novos (centavos). Null = o mesmo do molde.
  orcamentoCents   Int?
  atualizadoEm DateTime @updatedAt

  @@map("padrao_de_rascunho")
}

/// Respostas da API da FIPE guardadas, pra não gastar a cota diária (a tabela muda uma vez por mês).
model FipeCache {
  id        String   @id @default(cuid())
  /// O caminho consultado ("/brands/59/models").
  chave     String   @unique
  dados     Json
  buscadoEm DateTime @default(now())

  @@map("fipe_cache")
}

// ─── Tarefas pessoais ──────────────────────────────────────────────────────
//
// Lista de tarefas de cada pessoa da casa, criada pelo WhatsApp ("me lembra de ligar pra Vilela sexta", "toda segunda a
// Tatiana confere a verba") ou pelo Meu Dia. NÃO é a tabela `tasks` (essa é a das Operações, presa a um cliente).
//
// Concluir é uma LINHA em TarefaFeita (tarefa + dia), não uma coluna: assim a tarefa que repete todo dia pode ser
// concluída hoje sem apagar o que foi feito ontem, e o histórico (quem concluiu, quando) fica de graça.

enum RecorrenciaDaTarefa {
  NENHUMA
  DIARIA
  SEMANAL
  MENSAL
}

model Tarefa {
  id            String              @id @default(cuid())
  titulo        String
  responsavelId String
  responsavel   User                @relation("TarefaResponsavel", fields: [responsavelId], references: [id], onDelete: Cascade)
  /// Quem atribuiu. Diferente do responsável = avisa quem atribuiu quando for concluída.
  criadaPorId   String?
  criadaPor     User?               @relation("TarefaCriadaPor", fields: [criadaPorId], references: [id], onDelete: SetNull)
  recorrencia   RecorrenciaDaTarefa @default(NENHUMA)
  /// Única: o dia do prazo (vazio = sem prazo). Recorrente: o dia em que começa a valer.
  prazo         DateTime?           @db.Date
  /// SEMANAL: 0 = domingo … 6 = sábado.
  diaDaSemana   Int?
  /// MENSAL: 1 a 31 (mês mais curto cai no último dia).
  diaDoMes      Int?
  /// Tarefa cancelada (ou recorrente parada) fica guardada, mas sai das listas.
  ativa         Boolean             @default(true)
  /// "whatsapp" ou "sistema": de onde nasceu.
  origem        String              @default("sistema")
  criadaEm      DateTime            @default(now())
  feitas        TarefaFeita[]

  @@index([responsavelId, ativa])
  @@map("tarefas")
}

model TarefaFeita {
  id         String   @id @default(cuid())
  tarefaId   String
  tarefa     Tarefa   @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  /// O dia (da casa) em que foi concluída.
  dia        DateTime @db.Date
  feitaEm    DateTime @default(now())
  feitaPorId String?

  @@unique([tarefaId, dia])
  @@map("tarefas_feitas")
}

/// Os avisos de tarefa que o robô já mandou (de manhã, às 17h, atrasadas): um por pessoa, dia e tipo.
model AvisoDeTarefaEnviado {
  userId    String
  dia       DateTime @db.Date
  tipo      String
  enviadoEm DateTime @default(now())

  @@id([userId, dia, tipo])
  @@map("avisos_de_tarefa_enviados")
}

/// Cada dia em que alguém da casa visitou a loja, e o que foi falado. `Client.ultimaVisitaEm` continua existindo (a tabela de
/// clientes e os avisos leem dele) e é SEMPRE o dia mais recente daqui. Ver src/lib/visitas-registro.ts.
model VisitaDaLoja {
  id       String   @id @default(cuid())
  clientId String
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// O dia da visita (um por loja por dia).
  dia      DateTime @db.Date
  /// O que foi falado / combinado nessa visita.
  nota     String?  @db.Text
  quemId   String?
  quem     User?    @relation("QuemVisitou", fields: [quemId], references: [id], onDelete: SetNull)
  criadaEm DateTime @default(now())

  @@unique([clientId, dia])
  @@index([clientId, dia])
  @@map("visitas_da_loja")
}

/// Uma linha por chamada à IA: qual função do sistema chamou, qual modelo e quantos tokens. Serve pra responder "quanto gastamos
/// com cada coisa". Custo é ESTIMADO pelo preço de tabela (ver src/lib/ai/uso.ts); a conta real é a do painel da OpenAI.
model UsoDaIa {
  id              String   @id @default(cuid())
  quando          DateTime @default(now())
  funcao          String
  modelo          String
  entrada         Int      @default(0)
  cacheados       Int      @default(0)
  saida           Int      @default(0)
  /// Parte da saída que foi "pensamento" do modelo (cobrada como saída).
  raciocinio      Int      @default(0)
  segundosDeAudio Int?
  ms              Int      @default(0)

  @@index([quando])
  @@map("uso_da_ia")
}

/// A pergunta que o robô deixou aberta no grupo de uma loja: "qual desses eu tiro do ar?" (tipo "qual") ou "isso tira N
/// anúncios, confirma?" (tipo "confirmar"). A resposta seguinte de QUEM pediu escolhe só dentro de `candidatos`
/// ([{ adId, nome }]). Vale 15 minutos. Ver src/lib/whatsapp/pergunta-no-grupo.ts.
model PerguntaNoGrupo {
  grupoId    String   @id
  clientId   String
  quem       String?
  tipo       String
  candidatos Json
  feitaEm    DateTime @default(now())

  @@map("perguntas_no_grupo")
}

/// O banco de artes: a arte que o designer fez pra um carro. Ela é SEMPRE a 1ª foto do anúncio, e a proporção dela vale pro
/// anúncio todo (as fotos do site são cortadas na mesma proporção). Uma arte por carro; sem carro = ainda não atribuída.
model ArteDoCarro {
  id       String        @id @default(cuid())
  clientId String
  client   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  carroId  String?       @unique
  carro    EstoqueCarro? @relation(fields: [carroId], references: [id], onDelete: SetNull)
  /// O nome do arquivo que subiu (usado pra adivinhar o carro).
  nome     String
  mime     String
  largura  Int
  altura   Int
  bytes    Bytes
  criadoEm DateTime      @default(now())

  @@index([clientId, criadoEm])
  @@map("artes_dos_carros")
}
