// Prisma schema for Legacy OS — sistema interno da Legacy Digital
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Usuários & Acesso ──────────────────────────────────────────────────────

enum Role {
  ADMIN
  GERENTE
  GESTOR_TRAFEGO
}

// As duas empresas do grupo. O sistema é o mesmo; o que muda é de quem é o
// dinheiro, o funil e a meta. Separação vale na consulta ao banco, não no
// menu: o sócio do Treinamentos não pode ver o caixa da agência nem digitando
// a URL na mão.
enum Empresa {
  AGENCIA
  TREINAMENTOS
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  mustChangePassword Boolean @default(true)
  // Em quais empresas a pessoa trabalha. Quem tem as duas vê o grupo inteiro;
  // quem tem uma só nem sabe que a outra existe.
  empresas     Empresa[] @default([AGENCIA])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee         Employee?
  assignedTasks    Task[]           @relation("TaskAssignee")
  ownedLeads       Lead[]           @relation("LeadOwner")
  clientHistories  ClientHistory[]
  expensesLogged   Expense[]
  assignedTickets  SupportTicket[]  @relation("TicketAssignee")
  managedClients   Client[]         @relation("ClientManager")
  dailyReviews     DailyReview[]    @relation("DailyReviewer")
  weeklyReviews    WeeklyReview[]   @relation("WeeklyReviewer")
  campaignChanges  CampaignChange[] @relation("ChangeResponsible")
  playbooks        Playbook[]
  agendaItems      AgendaItem[]     @relation("AgendaOwner")
  salesRegistered  ClientSale[]     @relation("SaleCreator")
  pushSubscriptions PushSubscription[]
  gravacoes        Gravacao[]        @relation("GravacaoRegistrada")
  etapasConcluidas OnboardingEtapa[] @relation("EtapaConcluida")
  alertas          AlertaEstado[]
  clientesConferidos ClienteConferido[] @relation("QuemConferiu")
  resgatesFeitos     AcaoDeResgate[]    @relation("QuemResgatou")

  @@map("users")
}

// O que foi feito pra destravar uma loja que parou de vender.
//
// Vídeo e arte não entram aqui: a entrega da gravação já é registro dela
// mesma, e a arte é uma data no cliente. O que faltava era o comercial, que
// não deixa rastro em lugar nenhum — "falei com o dono" morre no WhatsApp.
//
// É log e não campo: o que importa é a sequência (falei dia 12, reuni dia
// 20), e campo único apagaria o anterior a cada passo.
enum TipoDeResgate {
  CONTATO
  REUNIAO
}

model AcaoDeResgate {
  id       String        @id @default(cuid())
  clientId String
  client   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tipo     TipoDeResgate

  quando DateTime @default(now())

  quemId String?
  quem   User?   @relation("QuemResgatou", fields: [quemId], references: [id], onDelete: SetNull)

  observacao String? @db.Text

  // Quantos aparelhos receberam o aviso dessa reunião.
  //
  // Fica gravado porque a confirmação na tela some quando a página se
  // atualiza — e aí ninguém mais saberia se o celular tocou. Com push
  // desligado isso daria uma reunião "avisada" que não avisou ninguém, que é
  // pior do que não ter o botão.
  avisados Int @default(0)

  @@index([clientId, quando])
  @@map("acoes_de_resgate")
}

// A caixinha do dia: "passei por este cliente hoje".
//
// NÃO é a revisão diária. A revisão exige foto da campanha e continua
// existindo do lado — misturar as duas faria um clique valer por uma
// conferência de verdade, e a foto deixaria de ser cobrada sem ninguém
// decidir isso.
//
// O que esta tabela resolve é outra coisa, e é a frase do Guilherme: não
// perder cliente de vista. Uma linha por cliente por dia; sem linha, ninguém
// olhou.
model ClienteConferido {
  id       String   @id @default(cuid())
  clientId String
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Só o dia, sem hora: a pergunta é "olhou hoje?", não "a que horas".
  dia DateTime @db.Date

  quemId String?
  quem   User?   @relation("QuemConferiu", fields: [quemId], references: [id], onDelete: SetNull)

  // A foto da campanha. Era cobrada todo dia; virou uma por semana, na
  // segunda-feira — e na segunda a caixinha não fecha sem ela. Cobrança
  // diária de foto vira foto repetida só pra fechar o quadrado, e aí o
  // registro deixa de valer como prova de que alguém olhou de verdade.
  fotoUrl String? @db.Text

  createdAt DateTime @default(now())

  // Um cliente é conferido uma vez por dia: clicar duas vezes não duplica.
  @@unique([clientId, dia])
  @@index([dia])
  @@map("clientes_conferidos")
}

// O que o banco não sabe sozinho sobre um alerta.
//
// O alerta em si NÃO fica gravado: ele é calculado na hora (ver
// src/lib/alertas/calcular.ts), então nasce quando o problema nasce e some
// quando o problema é resolvido, sem ninguém dar baixa. O que precisa de
// memória é outra coisa: até qual gravidade este alerta já foi pro celular
// desta pessoa, e se ela pediu pra lembrar depois.
//
// Uma linha por pessoa por alerta. Linha que sobra depois do problema
// resolvido não atrapalha: a chave simplesmente não aparece mais no cálculo.
model AlertaEstado {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A identidade do problema, ex "gravacao-atrasada:<id>". Texto livre de
  // propósito: mexer nos tipos de alerta não exige migração.
  chave String

  // Até qual degrau de gravidade já vibrou o celular desta pessoa. É o que
  // impede o mesmo problema de avisar todo dia: o aviso só sai de novo quando
  // PIORA. Zero = ainda não avisou nenhuma vez.
  nivelAvisado Int       @default(0)
  avisadoEm    DateTime?

  // Até qual degrau a pessoa já VIU dentro do sistema. É separado do celular
  // de propósito: enquanto o push não estiver configurado, "nunca avisei no
  // celular" valeria pra sempre, e o aviso dentro do sistema apareceria
  // eternamente. Aqui quem zera é abrir o painel ou a tela de Alertas.
  nivelVisto Int       @default(0)
  vistoEm    DateTime?

  // "Lembrar amanhã". Enquanto esta data não chegar, o alerta sai da tela e
  // não vibra celular. É de propósito que não exista "dispensar pra sempre":
  // alerta que se apaga com clique vira clique automático, e aí a central
  // mente dizendo que está tudo em ordem.
  silenciadoAte DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, chave])
  @@index([userId])
  @@map("alerta_estados")
}

// Quando o robô rodou pela última vez.
//
// Serve pra duas coisas. A tela mostra "conferido às 8h03", pra ninguém ficar
// na dúvida se o sistema está vivo. E a porta do robô usa isto como
// acelerador: sem o segredo configurado, ela só deixa rodar de novo depois de
// um intervalo, pra chamada repetida de fora não virar custo.
model RoboExecucao {
  // Nome do robô, pra caber mais de um aqui no futuro sem migração.
  nome    String   @id
  rodouEm DateTime @default(now())

  @@map("robo_execucoes")
}

enum AgendaItemType {
  AGENDAMENTO
  REUNIAO
  TEMPO
}

model AgendaItem {
  id      String         @id @default(cuid())
  ownerId String
  owner   User           @relation("AgendaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  type    AgendaItemType
  title   String
  startAt DateTime
  endAt   DateTime?
  notes   String?        @db.Text

  createdAt DateTime @default(now())

  @@index([ownerId, startAt])
  @@map("agenda_items")
}

// ─── Clientes ───────────────────────────────────────────────────────────────

enum ClientStatus {
  ATIVO
  IMPLANTACAO
  PAUSADO
  CANCELADO
}

model Client {
  id            String       @id @default(cuid())
  companyName   String
  contactName   String
  phone         String?
  whatsapp      String?
  email         String?
  city          String?
  state         String?
  cnpj          String?
  startDate     DateTime?
  plan          String?
  monthlyValue  Decimal      @default(0) @db.Decimal(12, 2)
  dueDay        Int?
  status        ClientStatus @default(IMPLANTACAO)
  // Permite excluir o cliente só do fluxo de cobrança mensal (Financeiro)
  // sem mudar o status dele em Clientes — ex: acordo especial, cortesia.
  billingActive Boolean      @default(true)
  // Quando a arte (os criativos do anúncio) foi renovada pela última vez.
  // Vazio = nunca renovou desde que entrou. Arte gasta é um dos três motivos
  // de uma loja parar de vender, junto com falta de vídeo e comercial travado.
  ultimaArteEm DateTime?
  // Último dia em que alguém da casa foi na loja. Vazio = nunca registrou
  // visita — que não é o mesmo que "nunca foi", é só que ninguém marcou.
  // Guarda só a data, não o histórico: o que se quer saber é há quanto tempo
  // não se aparece lá.
  ultimaVisitaEm DateTime?
  // Se esta conta entra no Controle de Vendas. Nem todo cliente é loja de
  // carro — consórcio, banco e afins não têm "carro vendido" pra cobrar, e
  // ficavam no vermelho pra sempre poluindo a tela. Tirar daqui não mexe em
  // mais nada do cliente: ele continua normal no resto do sistema.
  controlaVendas Boolean @default(true)
  internalNotes String?
  managerId     String?
  manager       User?        @relation("ClientManager", fields: [managerId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  attachments ClientAttachment[]
  history     ClientHistory[]
  revenues    Revenue[]
  contracts   Contract[]
  tasks       Task[]
  campaigns   Campaign[]
  reports     Report[]
  contentItems ContentItem[]
  supportTickets SupportTicket[]
  dailyReviews    DailyReview[]
  weeklyReviews   WeeklyReview[]
  campaignChanges CampaignChange[]
  sales           ClientSale[]
  pinnedInfo      ClientPinnedInfo[]
  onboardings     ClientOnboarding[]
  cobrancasPuladas CobrancaPulada[]
  conferencias     ClienteConferido[]
  resgates         AcaoDeResgate[]
  metaAdAccounts   MetaAdAccount[]
  gravacoes        Gravacao[]

  @@map("clients")
}

// Venda registrada pelo gestor (ex: carro vendido): quanto o cliente vendeu e
// quanto foi investido em anúncio pra vender aquilo. Alimenta o relatório
// mensal de vendas e o custo por venda.
model ClientSale {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  description String?
  value       Decimal  @db.Decimal(12, 2)
  adSpend     Decimal  @default(0) @db.Decimal(12, 2)
  soldAt      DateTime @db.Date
  createdById String?
  createdBy   User?    @relation("SaleCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([clientId, soldAt])
  @@map("client_sales")
}

// Informação fixada no topo da página do cliente (verba, cidade, contato do
// dono, o que a equipe precisar ter sempre à vista).
model ClientPinnedInfo {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label     String
  value     String
  createdAt DateTime @default(now())

  @@index([clientId])
  @@map("client_pinned_info")
}

model ClientAttachment {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileName   String
  url        String
  uploadedAt DateTime @default(now())

  @@map("client_attachments")
}

model ClientHistory {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  note      String
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@map("client_history")
}

// ─── Financeiro ─────────────────────────────────────────────────────────────

enum RevenueStatus {
  PAGO
  PENDENTE
  ATRASADO
}

model Revenue {
  id          String        @id @default(cuid())
  empresa     Empresa       @default(AGENCIA)
  // Entrada sem cliente na carteira existe: o Treinamentos vende curso, não
  // mensalidade de loja, e nem toda entrada da agência nasce de um contrato.
  // Nesses casos quem identifica a entrada é a descrição.
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  description String
  value       Decimal       @db.Decimal(12, 2)
  dueDate     DateTime
  paidDate    DateTime?
  status      RevenueStatus @default(PENDENTE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("revenues")
}

model Expense {
  id             String        @id @default(cuid())
  empresa        Empresa       @default(AGENCIA)
  description    String
  category       String
  value          Decimal       @db.Decimal(12, 2)
  date           DateTime
  responsibleId  String?
  responsible    User?         @relation(fields: [responsibleId], references: [id])
  fixedExpenseId String?
  fixedExpense   FixedExpense? @relation(fields: [fixedExpenseId], references: [id], onDelete: SetNull)
  // Saída fixa nasce não confirmada: só entra no DRE/DFC/lucro depois que o
  // Guilherme confirmar que saiu de verdade. Saída lançada na mão já nasce
  // confirmada, porque só se lança o que já aconteceu.
  paid           Boolean       @default(true)
  paidDate       DateTime?
  createdAt      DateTime      @default(now())

  @@index([empresa, date, paid])
  @@map("expenses")
}

// Despesas fixas/recorrentes (salários, aluguel, ferramentas...) — igual à
// mensalidade do cliente pro MRR, gera automaticamente o lançamento do mês.
model FixedExpense {
  id          String    @id @default(cuid())
  empresa     Empresa   @default(AGENCIA)
  description String
  category    String
  value       Decimal   @db.Decimal(12, 2)
  dueDay      Int?
  active      Boolean   @default(true)
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("fixed_expenses")
}

// ─── Contratos ──────────────────────────────────────────────────────────────

enum ContractTemplateType {
  TRAFEGO_PAGO
  SITE
  GESTAO_COMPLETA
  OUTRO
}

model ContractTemplate {
  id           String               @id @default(cuid())
  name         String
  type         ContractTemplateType
  bodyTemplate String               @db.Text
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  contracts Contract[]

  @@map("contract_templates")
}

enum ContractStatus {
  RASCUNHO
  AGUARDANDO_ASSINATURA
  ASSINADO
  CANCELADO
}

model Contract {
  id           String           @id @default(cuid())
  clientId     String
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templateId   String
  template     ContractTemplate @relation(fields: [templateId], references: [id])
  content      String           @db.Text
  value        Decimal          @db.Decimal(12, 2)
  status       ContractStatus   @default(RASCUNHO)
  pdfUrl       String?
  sentAt       DateTime?
  signedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("contracts")
}

// ─── Comercial (Pipeline) ───────────────────────────────────────────────────

// Origem antiga do lead. Ficou pro histórico: quem entrou antes do CRM novo
// tem esse campo preenchido. O que vale hoje é o canal.
enum LeadOrigin {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  INDICACAO
  SITE
  TRAFEGO_PAGO
}

// Por onde o lead chegou. É essa divisão que o dashboard usa pra abrir os
// números por canal.
enum LeadChannel {
  META
  PRESENCIAL
  REDE
  MESA_LOJISTA
  ORGANICO
}

// Etapas do funil, na ordem. Batem com os números do dashboard: cada coluna
// que o cartão passa vira uma linha lá.
enum LeadStage {
  LEAD
  QUALIFICADO
  REUNIAO_AGENDADA
  REUNIAO_REALIZADA
  PROPOSTA
  NEGOCIACAO
  FECHADO
  PERDIDO
}

model Lead {
  id          String      @id @default(cuid())
  empresa     Empresa     @default(AGENCIA)
  companyName String
  contactName String
  city        String?
  // UF. Quem chega pelo formulário da landing informa o estado, e sem isso a
  // cidade fica ambígua — tem São Miguel em meio Brasil.
  state       String?
  phone       String?
  origin      LeadOrigin?
  channel     LeadChannel @default(ORGANICO)
  stage       LeadStage   @default(LEAD)
  // Ordem do cartão dentro da coluna — é o que o arrastar pra cima/baixo grava.
  position    Int         @default(0)
  notes       String?
  ownerId     String?
  owner       User?       @relation("LeadOwner", fields: [ownerId], references: [id])

  // Marcos do funil. Guardamos a data de cada passo em vez de só a etapa atual:
  // um lead fechado continua tendo que contar como reunião realizada no mês em
  // que a reunião aconteceu. Voltar o cartão de coluna não apaga o que já foi.
  qualifiedAt    DateTime?
  meetingSetAt   DateTime?
  meetingHeldAt  DateTime?
  noShowAt       DateTime?
  proposalAt     DateTime?
  wonAt          DateTime?
  lostAt         DateTime?
  lostReason     String?

  // Fechou: quanto entra por mês, quanto entra de uma vez e por quantos meses.
  monthlyValue   Decimal @default(0) @db.Decimal(12, 2)
  setupValue     Decimal @default(0) @db.Decimal(12, 2)
  contractMonths Int     @default(12)

  // Rastro do anúncio, pra Meta conseguir ligar este lead ao clique que o
  // trouxe. Sem isso a Conversions API manda evento que não casa com ninguém e
  // o anúncio continua otimizando no escuro.
  fbclid          String?
  fbc             String?
  fbp             String?
  landingUrl      String?
  clientIp        String?
  clientUserAgent String?
  // O mesmo id que o Pixel usou no navegador. É ele que faz a Meta entender
  // que o evento do site e o nosso são o mesmo lead, e não dois.
  pixelEventId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleEvent  CommercialEvent?
  metaEvents MetaCapiEvent[]

  @@index([empresa, stage, position])
  @@index([empresa, channel, createdAt])
  @@map("leads")
}

// Cada aviso mandado pra Meta pela Conversions API. Existe porque envio de
// evento é invisível: sem registro, ninguém descobre que parou de funcionar
// até o anúncio começar a otimizar errado. Também segura a repetição — evento
// já enviado com sucesso não vai de novo.
model MetaCapiEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  eventName String
  eventId   String
  sucesso   Boolean  @default(false)
  resposta  String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([leadId, eventName])
  @@index([createdAt])
  @@map("meta_capi_events")
}

// Aparelho que aceitou receber aviso do Legacy OS. É o navegador quem gera o
// endereço e as chaves; guardamos pra conseguir empurrar a notificação depois,
// mesmo com o app fechado. Assinatura que o navegador cancela vira 404/410 no
// envio e é apagada na hora.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

// Cliente tirado da cobrança de UM mês específico. É por mês de propósito: o
// botão do quadro serve pra "esse mês não cobra" (negociação, cortesia, mês
// pulado), não pra desligar o cliente. No mês seguinte ele volta sozinho.
// Pra parar de vez, o caminho é mudar o status em Clientes.
model CobrancaPulada {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month     String // aaaa-mm
  createdAt DateTime @default(now())

  @@unique([clientId, month])
  @@index([month])
  @@map("cobrancas_puladas")
}

// Caixa preta do formulário público: tudo que chegou e NÃO virou lead fica
// aqui, com o corpo cru. Existe porque lead perdido some sem deixar rastro —
// cinco pessoas preencheram, o Pixel contou, e não havia onde olhar. Com isto,
// dá pra ver o que a landing mandou e recuperar o contato na mão.
model LeadRecusado {
  id        String   @id @default(cuid())
  motivo    String
  status    Int
  origem    String?
  ip        String?
  corpo     String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("leads_recusados")
}

// Cada envio do formulário público, guardado só pra segurar o limite por IP.
// Fica no banco em vez de na memória porque na Vercel cada requisição pode cair
// numa instância diferente, e elas reiniciam a cada deploy: contador em memória
// não segura nada de verdade. Linha com mais de um dia é apagada.
model TentativaLead {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@map("tentativas_lead")
}

// Quanto cada canal entregou de impressão e consumiu de verba no mês. É o que
// transforma o funil em custo: sem isso não existe CPL, custo por reunião, CAC.
model ChannelMonth {
  id          String      @id @default(cuid())
  empresa     Empresa     @default(AGENCIA)
  month       String // aaaa-mm
  channel     LeadChannel
  impressions Int         @default(0)
  investment  Decimal     @default(0) @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Cada empresa lança a verba dela: as duas anunciam no mesmo canal no mesmo
  // mês, e somar as duas faria o CPL de cada uma sair errado.
  @@unique([empresa, month, channel])
  @@map("channel_months")
}

// ─── Operações (Tarefas) ────────────────────────────────────────────────────

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  FINALIZADO
}

model Task {
  id          String       @id @default(cuid())
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  title       String
  description String?
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIA)
  status      TaskStatus   @default(PENDENTE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("tasks")
}

// ─── Tráfego Pago ───────────────────────────────────────────────────────────

model Campaign {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  investment  Decimal  @db.Decimal(12, 2)
  leads       Int      @default(0)
  reach       Int      @default(0)
  impressions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("campaigns")
}

