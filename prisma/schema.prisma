// Prisma schema for Legacy OS — sistema interno da Legacy Digital
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Usuários & Acesso ──────────────────────────────────────────────────────

enum Role {
  ADMIN
  GERENTE
  GESTOR_TRAFEGO
}

// As duas empresas do grupo. O sistema é o mesmo; o que muda é de quem é o
// dinheiro, o funil e a meta. Separação vale na consulta ao banco, não no
// menu: o sócio do Treinamentos não pode ver o caixa da agência nem digitando
// a URL na mão.
enum Empresa {
  AGENCIA
  TREINAMENTOS
}

model User {
  id    String @id @default(cuid())
  name  String
  email String @unique

  /// O WhatsApp pessoal, pra IA saber de quem é a mensagem que chega no
  /// privado dela. Só dígitos com DDI e DDD (5542988126561).
  ///
  /// Único de propósito: dois colaboradores com o mesmo número fariam a
  /// pergunta de um ser respondida com a carteira do outro — e a busca
  /// escolheria qual arbitrariamente, o que é o pior tipo de erro: o que
  /// acerta na maioria das vezes.
  whatsapp           String?   @unique
  passwordHash       String
  role               Role
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  // Em quais empresas a pessoa trabalha. Quem tem as duas vê o grupo inteiro;
  // quem tem uma só nem sabe que a outra existe.
  empresas           Empresa[] @default([AGENCIA])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee             Employee?
  assignedTasks        Task[]                 @relation("TaskAssignee")
  ownedLeads           Lead[]                 @relation("LeadOwner")
  clientHistories      ClientHistory[]
  expensesLogged       Expense[]
  gruposFinanceiros    GrupoFinanceiro[]      @relation("DonoDoGrupoFinanceiro")
  gastosPessoais       GastoPessoal[]         @relation("DonoDoGastoPessoal")
  assignedTickets      SupportTicket[]        @relation("TicketAssignee")
  managedClients       Client[]               @relation("ClientManager")
  dailyReviews         DailyReview[]          @relation("DailyReviewer")
  weeklyReviews        WeeklyReview[]         @relation("WeeklyReviewer")
  campaignChanges      CampaignChange[]       @relation("ChangeResponsible")
  playbooks            Playbook[]
  agendaItems          AgendaItem[]           @relation("AgendaOwner")
  salesRegistered      ClientSale[]           @relation("SaleCreator")
  pushSubscriptions    PushSubscription[]
  gravacoes            Gravacao[]             @relation("GravacaoRegistrada")
  etapasConcluidas     OnboardingEtapa[]      @relation("EtapaConcluida")
  alertas              AlertaEstado[]
  clientesConferidos   ClienteConferido[]     @relation("QuemConferiu")
  relatoriosEnviados   RelatorioEnviado[]     @relation("QuemMandouRelatorio")
  relatoriosDecididos  RelatorioParaAprovar[] @relation("QuemDecidiuRelatorio")
  conversaDoCopiloto   ConversaDoCopiloto?
  studioArtesCriadas   StudioArte[]           @relation("StudioCriou")
  studioArtesRevisadas StudioArte[]           @relation("StudioRevisou")
  resgatesFeitos       AcaoDeResgate[]        @relation("QuemResgatou")
  verbasPedidas        PedidoDeVerba[]        @relation("VerbaPedidaPor")
  metaAcoes            MetaAcao[]             @relation("MetaAcaoFeitaPor")
  tarefasDele          Tarefa[]               @relation("TarefaResponsavel")
  tarefasQueCriou      Tarefa[]               @relation("TarefaCriadaPor")
  visitasRegistradas   VisitaDaLoja[]         @relation("QuemVisitou")

  @@map("users")
}

// O que foi feito pra destravar uma loja que parou de vender.
//
// Vídeo e arte não entram aqui: a entrega da gravação já é registro dela
// mesma, e a arte é uma data no cliente. O que faltava era o comercial, que
// não deixa rastro em lugar nenhum — "falei com o dono" morre no WhatsApp.
//
// É log e não campo: o que importa é a sequência (falei dia 12, reuni dia
// 20), e campo único apagaria o anterior a cada passo.
enum TipoDeResgate {
  CONTATO
  REUNIAO
}

model AcaoDeResgate {
  id       String        @id @default(cuid())
  clientId String
  client   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tipo     TipoDeResgate

  quando DateTime @default(now())

  quemId String?
  quem   User?   @relation("QuemResgatou", fields: [quemId], references: [id], onDelete: SetNull)

  observacao String? @db.Text

  // Quantos aparelhos receberam o aviso dessa reunião.
  //
  // Fica gravado porque a confirmação na tela some quando a página se
  // atualiza — e aí ninguém mais saberia se o celular tocou. Com push
  // desligado isso daria uma reunião "avisada" que não avisou ninguém, que é
  // pior do que não ter o botão.
  avisados Int @default(0)

  @@index([clientId, quando])
  @@map("acoes_de_resgate")
}

// A caixinha do dia: "passei por este cliente hoje".
//
// NÃO é a revisão diária. A revisão exige foto da campanha e continua
// existindo do lado — misturar as duas faria um clique valer por uma
// conferência de verdade, e a foto deixaria de ser cobrada sem ninguém
// decidir isso.
//
// O que esta tabela resolve é outra coisa, e é a frase do Guilherme: não
// perder cliente de vista. Uma linha por cliente por dia; sem linha, ninguém
// olhou.
/**
 * "O relatório desta semana já foi mandado pra esta loja?"
 * Existe porque esquecer é o modo de falha real aqui. O relatório sai pronto
 * sozinho toda segunda, mas quem aperta "enviar" é gente — e gente com
 * quarenta lojas pula uma sem perceber. Sem este registro, a única forma de
 * saber qual faltou seria abrir quarenta conversas do WhatsApp.
 * A chave é a SEMANA, não o dia: o gestor que manda na terça precisa fechar
 * a mesma semana que o que mandou na segunda, senão a mesma loja contaria
 * duas vezes e a lista nunca zeraria.
 */
/**
 * As tentativas do robô de mandar o relatório da semana.
 * ── Por que não dá pra viver só com RelatorioEnviado ─────────────────────
 * Porque aquela tabela só ganha linha quando DEU CERTO. O robô acorda de
 * cinco em cinco minutos na manhã de segunda; uma loja que falha sempre — a
 * que não teve leitura boa da Meta, por exemplo — seria tentada de novo a
 * cada rodada, por horas, e cada tentativa gera a imagem do relatório antes
 * de descobrir que não vai dar.
 * Com esta tabela o robô sabe quantas vezes já tentou nesta semana e para
 * depois do teto. E o erro fica guardado, que é o que o Meu Dia precisa pra
 * dizer QUAL loja não recebeu e por quê — em vez de só não aparecer.
 */
model TentativaDeRelatorio {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// A segunda-feira da semana, igual à de RelatorioEnviado.
  semana DateTime @db.Date

  /// Quantas vezes o robô já tentou esta loja nesta semana.
  tentativas Int @default(0)

  /// O motivo da última falha, pra aparecer no Meu Dia.
  ultimoErro String?

  ultimaEm DateTime @default(now())

  @@unique([clientId, semana])
  @@index([semana])
  @@map("tentativas_de_relatorio")
}

model RelatorioEnviado {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /**
   * A segunda-feira da semana, no fuso da casa. Ver src/lib/dia-da-casa.ts.
   */
  semana DateTime @db.Date

  enviadoEm DateTime @default(now())

  quemId String?
  quem   User?   @relation("QuemMandouRelatorio", fields: [quemId], references: [id], onDelete: SetNull)

  // Uma loja fecha uma vez por semana: marcar duas vezes não duplica.
  @@unique([clientId, semana])
  @@index([semana])
  @@map("relatorios_enviados")
}

enum EstadoDaAprovacao {
  PENDENTE
  APROVADO
  RECUSADO
}

/// Relatório que o robô da segunda NÃO mandou sozinho, à espera de gente.
///
/// A regra é do Guilherme: custo por lead abaixo de R$ 12 sai automático;
/// de R$ 12 pra cima passa pela aprovação da Andrielli. Ver
/// src/lib/whatsapp/decidir-envio.ts, que é onde a regra mora.
///
/// Existe uma linha por loja por semana, e ela é o que TIRA a loja da fila
/// do robô: sem isso a loja cara seria reavaliada de cinco em cinco minutos
/// a manhã inteira e viraria uma fila de aprovações repetidas.
model RelatorioParaAprovar {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// A segunda-feira da semana, igual à de RelatorioEnviado.
  semana DateTime @db.Date

  /// O custo por lead que segurou o relatório, em centavos.
  /// Null quando não houve lead nenhum — que é outro motivo, não "custo zero".
  cplCents Int?

  /// Gasto e leads do período, pra decidir sem precisar abrir o relatório.
  spendCents Int @default(0)
  leads      Int @default(0)

  /// Por que não saiu sozinho: "cpl-alto", "sem-lead" ou "sem-gasto".
  motivoDaEspera String

  estado EstadoDaAprovacao @default(PENDENTE)

  criadoEm   DateTime  @default(now())
  decididoEm DateTime?

  decididoPorId String?
  decididoPor   User?   @relation("QuemDecidiuRelatorio", fields: [decididoPorId], references: [id], onDelete: SetNull)

  /// O que a pessoa escreveu ao recusar.
  observacao String?

  @@unique([clientId, semana])
  @@index([estado, semana])
  @@map("relatorios_para_aprovar")
}

/// A conversa de uma pessoa da casa com a IA no privado do WhatsApp.
///
/// Uma linha por pessoa, sobrescrita: não é histórico pra consultar, é a
/// memória curta que faz "e a outra loja?" ter sentido. Conversa de chat não
/// é registro contábil, e guardar tudo pra sempre seria guardar os números
/// das lojas em mais um lugar sem ninguém precisar deles ali.
model ConversaDoCopiloto {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Os últimos turnos, em JSON: [{ de: "gestor" | "copiloto", texto }].
  turnos Json @default("[]")

  /// A ação que a IA propôs e espera um "confirma" pra fazer.
  /// Null quando não há nada pendente. Ver atender-privado.ts.
  acaoPendente Json?
  propostaEm   DateTime?

  atualizadoEm DateTime @updatedAt

  @@map("conversas_do_copiloto")
}

/// As mensagens do WhatsApp que já foram tratadas.
///
/// ── O defeito que isto conserta ──────────────────────────────────────────
///
/// A Z-API REENVIA o webhook quando não recebe resposta rápido. E atender uma
/// pergunta da IA leva dezenas de segundos — são duas chamadas ao modelo. A
/// Z-API desiste de esperar, manda de novo, e a mesma mensagem é atendida
/// duas vezes.
///
/// No privado isso é a pessoa recebendo a resposta repetida — chato, e o
/// dobro do custo de IA. No GRUPO é o mesmo anúncio sendo desligado duas
/// vezes, e a segunda vez acontece num anúncio que já estava fora do ar.
///
/// A trava é o id da mensagem: quem chega primeiro CRIA a linha, e quem chega
/// depois esbarra no índice único e vai embora sem fazer nada. É o banco
/// decidindo, não o código — duas chamadas simultâneas não têm como passar as
/// duas.
model MensagemTratada {
  /// O id que a Z-API dá à mensagem.
  messageId String   @id
  criadoEm  DateTime @default(now())

  @@index([criadoEm])
  @@map("mensagens_tratadas")
}

/// Grupo do WhatsApp onde a IA responde pergunta da EQUIPE.
///
/// ── Por que isto é uma lista explícita, e não um sim-ou-não ─────────────
///
/// Porque o estrago do contrário é grave e silencioso. Se a IA respondesse
/// pergunta em qualquer grupo, bastaria alguém perguntar "quais lojas estão
/// sem verba?" no grupo de um cliente pra ela listar as lojas dos outros
/// clientes ali dentro — nomes, gastos e resultados de quem não tem nada a
/// ver com aquela conversa.
///
/// Então ela só responde onde foi explicitamente autorizada, e a autorização
/// é por grupo. Um grupo novo nasce fora desta lista, como deve ser.
model GrupoInterno {
  /// O id do grupo na Z-API, como "120363396517254902-group".
  grupoId String @id

  /// O nome, só pra tela não mostrar um id cru.
  nome String

  criadoEm DateTime @default(now())

  @@map("grupos_internos")
}

/// O retrato do que a Z-API mandou, pra parar de adivinhar.
///
/// ── Por que isto existe ──────────────────────────────────────────────────
///
/// Porque o atendimento é feito DEPOIS da resposta HTTP (ver so-uma-vez.ts),
/// e isso tirou a única janela em que dava pra perguntar ao sistema o que ele
/// decidiu. Quando uma mensagem de grupo some sem deixar rastro, não sobra
/// nada pra olhar — e o diagnóstico vira chute.
///
/// ── O que é guardado, e o que não é ──────────────────────────────────────
///
/// A ESTRUTURA do recado, não o conteúdo: quais campos vieram, se era grupo,
/// quem escreveu, se o robô foi marcado. O texto da mensagem NÃO é guardado,
/// porque pra descobrir por que o robô não respondeu basta saber se havia uma
/// marcação nele — e guardar conversa de grupo de cliente num banco é criar
/// um problema maior que o que se está resolvendo.
model RecadoDaZapi {
  id         String   @id @default(cuid())
  recebidoEm DateTime @default(now())

  /// Os campos de primeiro nível que vieram, em ordem.
  chaves String

  isGroup Boolean?
  fromMe  Boolean?

  /// De onde veio: o id do grupo, ou o telefone de quem mandou no privado.
  de           String?
  /// Dentro de um grupo, quem escreveu.
  participante String?
  /// O número que a Z-API diz ser o do robô. Sem isto não dá pra saber se o
  /// @ da mensagem era pra ele — é o suspeito número um.
  numeroDoRobo String?
  /// Os marcados, quando a Z-API manda a lista.
  mencionados  String?

  /// O texto tinha "@" seguido de dígitos? É o que a detecção procura.
  temArrobaComNumero Boolean @default(false)
  /// Tamanho do texto, só pra saber que havia texto.
  tamanhoDoTexto     Int     @default(0)

  @@index([recebidoEm])
  @@map("recados_da_zapi")
}

model ClienteConferido {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Só o dia, sem hora: a pergunta é "olhou hoje?", não "a que horas".
  dia DateTime @db.Date

  quemId String?
  quem   User?   @relation("QuemConferiu", fields: [quemId], references: [id], onDelete: SetNull)

  // A foto da campanha. Era cobrada todo dia; virou uma por semana, na
  // segunda-feira — e na segunda a caixinha não fecha sem ela. Cobrança
  // diária de foto vira foto repetida só pra fechar o quadrado, e aí o
  // registro deixa de valer como prova de que alguém olhou de verdade.
  fotoUrl String? @db.Text

  createdAt DateTime @default(now())

  // Um cliente é conferido uma vez por dia: clicar duas vezes não duplica.
  @@unique([clientId, dia])
  @@index([dia])
  @@map("clientes_conferidos")
}

// O que o banco não sabe sozinho sobre um alerta.
//
// O alerta em si NÃO fica gravado: ele é calculado na hora (ver
// src/lib/alertas/calcular.ts), então nasce quando o problema nasce e some
// quando o problema é resolvido, sem ninguém dar baixa. O que precisa de
// memória é outra coisa: até qual gravidade este alerta já foi pro celular
// desta pessoa, e se ela pediu pra lembrar depois.
//
// Uma linha por pessoa por alerta. Linha que sobra depois do problema
// resolvido não atrapalha: a chave simplesmente não aparece mais no cálculo.
model AlertaEstado {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A identidade do problema, ex "gravacao-atrasada:<id>". Texto livre de
  // propósito: mexer nos tipos de alerta não exige migração.
  chave String

  // Até qual degrau de gravidade já vibrou o celular desta pessoa. É o que
  // impede o mesmo problema de avisar todo dia: o aviso só sai de novo quando
  // PIORA. Zero = ainda não avisou nenhuma vez.
  nivelAvisado Int       @default(0)
  avisadoEm    DateTime?

  // Até qual degrau a pessoa já VIU dentro do sistema. É separado do celular
  // de propósito: enquanto o push não estiver configurado, "nunca avisei no
  // celular" valeria pra sempre, e o aviso dentro do sistema apareceria
  // eternamente. Aqui quem zera é abrir o painel ou a tela de Alertas.
  nivelVisto Int       @default(0)
  vistoEm    DateTime?

  // "Lembrar amanhã". Enquanto esta data não chegar, o alerta sai da tela e
  // não vibra celular. É de propósito que não exista "dispensar pra sempre":
  // alerta que se apaga com clique vira clique automático, e aí a central
  // mente dizendo que está tudo em ordem.
  silenciadoAte DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, chave])
  @@index([userId])
  @@map("alerta_estados")
}

// Quando o robô rodou pela última vez.
//
// Serve pra duas coisas. A tela mostra "conferido às 8h03", pra ninguém ficar
// na dúvida se o sistema está vivo. E a porta do robô usa isto como
// acelerador: sem o segredo configurado, ela só deixa rodar de novo depois de
// um intervalo, pra chamada repetida de fora não virar custo.
model RoboExecucao {
  // Nome do robô, pra caber mais de um aqui no futuro sem migração.
  nome    String   @id
  rodouEm DateTime @default(now())

  @@map("robo_execucoes")
}

// ─────────────────────────── Legacy Studio ──────────────────────────────
//
// A produção de arte e vídeo das lojas, feita pelo sistema com revisão de
// gente no fim. Hoje cada arte é montada à mão num editor de imagem a partir
// da foto que a loja mandou — mesma moldura, mesmo preço, mesma logo, trinta
// vezes por semana.
//
// ── A decisão que manda neste pedaço: a arte NÃO é guardada ──────────────
//
// Guarda-se a foto do carro e os dados do veículo. O PNG de feed e o de
// Stories são desenhados na hora em que alguém abre ou baixa.
//
// É a mesma escolha do relatório do cliente, e pelos mesmos motivos. Guardar
// as duas artes triplicaria o espaço por anúncio — e, pior, congelaria o
// desenho: no dia em que a loja trocar de logo ou a gente melhorar o layout,
// as artes antigas continuariam com a cara velha, e alguém teria que achar e
// refazer uma a uma. Desenhando na hora, trocar a logo conserta tudo.

/**
 * A identidade visual de uma loja.
 * Uma por cliente. Sem ela a arte ainda sai, com a cara neutra do sistema —
 * mas é ela que faz a peça parecer da loja e não de um gerador qualquer.
 */
model StudioMarca {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /**
   * A logo da loja, como data URI. Reduzida na hora de subir.
   */
  logoUrl String? @db.Text

  /**
   * As cores da loja, em #rrggbb. O padrão é um preto-e-dourado neutro.
   */
  corPrimaria String @default("#FFC20E")
  corFundo    String @default("#0A0A0A")
  corTexto    String @default("#FFFFFF")

  /**
   * Vão no rodapé da arte, quando existem.
   */
  telefone String?
  endereco String?

  /**
   * Qual desenho esta loja usa: "degrade", "faixa" ou "etiqueta".
   * Texto e não enum de propósito: desenho novo entra sem migração, e
   * layout que não existe mais cai no padrão em vez de quebrar a arte.
   * Mesma escolha dos tipos de alerta, pelo mesmo motivo.
   */
  layout String @default("degrade")

  atualizadoEm DateTime @updatedAt
  criadoEm     DateTime @default(now())

  @@map("studio_marcas")
}

/**
 * O estado de uma peça na esteira.
 * Quatro e não dois porque "pronto" e "aprovado" são coisas diferentes: a
 * máquina termina, mas quem responde pelo que vai ao ar é gente. E
 * "corrigir" precisa existir separado de "rascunho" pra que o pedido de
 * correção não se perca junto com o que nunca foi olhado.
 */
enum StudioStatus {
  PRONTO
  APROVADO
  CORRIGIR
}

/**
 * Uma arte de veículo.
 * Um registro gera DUAS peças — feed (quadrado) e Stories (vertical) — porque
 * são a mesma informação em dois recortes. Separar em dois registros faria a
 * equipe aprovar duas vezes a mesma coisa e deixaria aparecer no mundo um
 * feed aprovado com um Stories reprovado do mesmo carro.
 */
model StudioArte {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /**
   * A foto do carro, já reduzida, como data URI.
   */
  fotoUrl String @db.Text

  // ── O que vai escrito na arte ──
  /// "CHEVROLET". Vai menor, acima do modelo — é como a arte da casa faz.
  marca        String?
  /// "CRUZE". O nome grande.
  modelo       String
  /// "LTZ2 SPORT6". Vai numa caixa da cor da loja, abaixo do modelo.
  versao       String?
  ano          String?
  kmTexto      String?
  precoCents   Int?
  /// O preço "de", riscado, quando a loja anuncia desconto.
  precoDeCents Int?
  /// A ficha, separada por "|": "1.4 TURBO | AUTOMÁTICO | TETO SOLAR".
  /// Texto livre porque cada loja destaca o que quer, e uma lista fixa de
  /// campos faria a equipe deixar metade em branco.
  detalhes     String?
  /**
   * "Entrada + 48x", "Aceita troca", o que a loja quiser destacar.
   */
  chamada      String?

  status   StudioStatus @default(PRONTO)
  /**
   * O que o revisor pediu pra mudar. Só existe quando status = CORRIGIR.
   */
  correcao String?      @db.Text

  criadoPorId String?
  criadoPor   User?   @relation("StudioCriou", fields: [criadoPorId], references: [id], onDelete: SetNull)

  revisadoPorId String?
  revisadoPor   User?     @relation("StudioRevisou", fields: [revisadoPorId], references: [id], onDelete: SetNull)
  revisadoEm    DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([clientId, criadoEm])
  @@index([status, criadoEm])
  @@map("studio_artes")
}

enum AgendaItemType {
  AGENDAMENTO
  REUNIAO
  TEMPO
}

model AgendaItem {
  id      String         @id @default(cuid())
  ownerId String
  owner   User           @relation("AgendaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  type    AgendaItemType
  title   String
  startAt DateTime
  endAt   DateTime?
  notes   String?        @db.Text

  createdAt DateTime @default(now())

  @@index([ownerId, startAt])
  @@map("agenda_items")
}

// ─── Clientes ───────────────────────────────────────────────────────────────

enum ClientStatus {
  ATIVO
  IMPLANTACAO
  PAUSADO
  CANCELADO
}

model Client {
  id                       String       @id @default(cuid())
  companyName              String
  contactName              String
  phone                    String?
  whatsapp                 String?
  email                    String?
  city                     String?
  state                    String?
  cnpj                     String?
  startDate                DateTime?
  plan                     String?
  monthlyValue             Decimal      @default(0) @db.Decimal(12, 2)
  dueDay                   Int?
  status                   ClientStatus @default(IMPLANTACAO)
  // Permite excluir o cliente só do fluxo de cobrança mensal (Financeiro)
  // sem mudar o status dele em Clientes — ex: acordo especial, cortesia.
  billingActive            Boolean      @default(true)
  // Quando a arte (os criativos do anúncio) foi renovada pela última vez.
  // Vazio = nunca renovou desde que entrou. Arte gasta é um dos três motivos
  // de uma loja parar de vender, junto com falta de vídeo e comercial travado.
  ultimaArteEm             DateTime?
  // Quanto a loja combinou de investir por mês em anúncio, em centavos.
  //
  // Serve de régua pra "o saldo está acabando?". R$ 100 é uma semana pra quem
  // gasta R$ 300 no mês e é meio dia pra quem gasta R$ 6.000 — sem referência
  // não dá pra dizer se está acabando.
  //
  // É o plano B: quando há gasto de verdade nos últimos dias, a conta usa o
  // gasto REAL, que é melhor porque acompanha a realidade sozinho. Este campo
  // entra quando a loja é nova ou ficou parada e não há de onde calcular.
  gastoMensalPrevistoCents Int?

  /**
   * O grupo de WhatsApp desta loja, pra onde o relatório da semana vai.
   * No formato que a Z-API usa: `120363019502650977-group`. Pega-se o id no
   * painel da Z-API, na lista de grupos — não é o número de telefone de
   * ninguém, é o identificador do grupo.
   * Vazio quer dizer "ainda manda na mão": a loja aparece no Meu Dia com o
   * botão de marcar, mas sem o de enviar. Melhor isso do que um envio
   * silencioso pro lugar errado.
   */
  /// Único no BANCO, e não só na tela.
  ///
  /// A regra "um grupo não serve a duas lojas" já era conferida ao salvar,
  /// mas só ali. Um teste pôs o mesmo grupo em duas lojas por outro caminho
  /// e o banco aceitou — e com duas linhas iguais, quem procura a loja de um
  /// grupo recebe UMA DELAS, a que o banco devolver primeiro. O robô
  /// desligaria o anúncio de uma loja por pedido de outra.
  ///
  /// Nulo não conta pro índice no Postgres, então loja sem grupo continua
  /// podendo ser quantas forem.
  /// Tirada do acompanhamento do Meta Ads.
  ///
  /// Não é cancelamento nem desvínculo: a loja continua cliente, continua no
  /// Financeiro, e os números já buscados continuam no banco. Ela só some da
  /// tela do Meta Ads, dos alertas de saldo, do Meu Dia, do relatório
  /// automático e do Copiloto.
  ///
  /// Existe porque nem toda loja da casa é acompanhada por aqui, e uma loja
  /// que ninguém olha ficava gerando alerta que ninguém trata — e alerta que
  /// ninguém trata ensina todo mundo a ignorar alerta.
  ///
  /// A varredura CONTINUA buscando os números dela, de propósito: é barato,
  /// e é o que faz trazer de volta ser um clique sem buraco no histórico.
  foraDoMetaAds Boolean @default(false)

  whatsappGrupoId String? @unique

  /// O robô pode desligar anúncio sozinho quando alguém pedir no grupo?
  ///
  /// Nasce DESLIGADO, e é por loja. Desligar o anúncio errado é a loja
  /// perdendo lead do carro que ainda está no pátio, calada — então isto é
  /// coisa que se liga olhando, loja por loja, depois de ver o robô acertar
  /// algumas vezes. Ligado em massa no primeiro dia seria confiar antes de
  /// conferir.
  whatsappDesligaAuto Boolean   @default(false)
  // Último dia em que alguém da casa foi na loja. Vazio = nunca registrou
  // visita — que não é o mesmo que "nunca foi", é só que ninguém marcou.
  // Guarda só a data, não o histórico: o que se quer saber é há quanto tempo
  // não se aparece lá.
  ultimaVisitaEm      DateTime?
  // Se esta conta entra no Controle de Vendas. Nem todo cliente é loja de
  // carro — consórcio, banco e afins não têm "carro vendido" pra cobrar, e
  // ficavam no vermelho pra sempre poluindo a tela. Tirar daqui não mexe em
  // mais nada do cliente: ele continua normal no resto do sistema.
  controlaVendas      Boolean   @default(true)
  internalNotes       String?
  managerId           String?
  manager             User?     @relation("ClientManager", fields: [managerId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  attachments           ClientAttachment[]
  history               ClientHistory[]
  revenues              Revenue[]
  contracts             Contract[]
  tasks                 Task[]
  campaigns             Campaign[]
  reports               Report[]
  contentItems          ContentItem[]
  supportTickets        SupportTicket[]
  dailyReviews          DailyReview[]
  weeklyReviews         WeeklyReview[]
  campaignChanges       CampaignChange[]
  sales                 ClientSale[]
  pinnedInfo            ClientPinnedInfo[]
  onboardings           ClientOnboarding[]
  visitasDaLoja         VisitaDaLoja[]
  cobrancasPuladas      CobrancaPulada[]
  conferencias          ClienteConferido[]
  relatoriosEnviados    RelatorioEnviado[]
  tentativasDeRelatorio TentativaDeRelatorio[]
  relatoriosParaAprovar RelatorioParaAprovar[]
  studioMarca           StudioMarca?
  studioArtes           StudioArte[]
  resgates              AcaoDeResgate[]
  metaAdAccounts        MetaAdAccount[]
  gravacoes             Gravacao[]
  pedidosDeVerba        PedidoDeVerba[]
  metaAcoes             MetaAcao[]
  vendasAguardando      VendaAguardandoDados[]

  @@map("clients")
  estoqueDaLoja EstoqueDaLoja?
  estoqueCarros EstoqueCarro[]
  artesDosCarros ArteDoCarro[]
}

/// O que o sistema MANDOU a Meta fazer, e o que ela respondeu.
///
/// Toda vez que alguém liga ou desliga uma campanha por aqui, fica uma linha.
/// Não é burocracia: pausar campanha é a primeira coisa que este sistema faz
/// que MUDA a realidade da loja em vez de só mostrá-la. Quando uma loja ficar
/// um dia sem entregar, a pergunta vai ser "quem desligou?" — e sem registro a
/// resposta é um silêncio constrangedor.
///
/// Guarda a tentativa, não só o sucesso: chamada que falhou é justamente a que
/// interessa depois, porque é ela que explica a campanha que "não desligou".
model MetaAcao {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  quemId String?
  quem   User?   @relation("MetaAcaoFeitaPor", fields: [quemId], references: [id])

  /// "campanha", "conjunto" ou "anuncio".
  nivel    String
  /// O id na Meta do objeto mexido.
  objetoId String
  /// O nome que estava na tela na hora — pro registro continuar legível
  /// depois que a campanha for renomeada ou apagada lá.
  nome     String

  /// O que foi mexido: "status" (ligar/desligar) ou "verba" (orçamento).
  ///
  /// Tem padrão "status" porque toda linha que já existia era disso — a
  /// tabela nasceu só pro ligar/desligar. Em vez de uma segunda tabela quase
  /// igual, ela ganhou um tipo: a pergunta feita aqui é sempre a mesma ("o
  /// que mexeram nisto, quem, e deu certo?"), e separar forçaria juntar as
  /// duas de novo pra responder.
  tipo String @default("status")

  /// Em tipo "status": "ACTIVE" ou "PAUSED". Em tipo "verba": qual campo foi
  /// escrito na Meta ("daily_budget" ou "lifetime_budget").
  statusPedido String
  /// O que estava antes, pelo nosso cadastro. Vazio se não sabíamos.
  statusAntes  String?

  /// Só em tipo "verba": o orçamento pedido e o que havia antes.
  valorPedidoCents Int?
  valorAntesCents  Int?

  /// Só em tipo "texto": a legenda antes e depois da edição.
  ///
  /// Guardados por inteiro, e não só "mudou": quando alguém perguntar por
  /// que o anúncio perdeu os comentários, a resposta é esta linha — quem
  /// mexeu, quando, e o que exatamente trocou. Sem o texto velho, a única
  /// forma de saber seria a memória de quem editou.
  textoAntes  String? @db.Text
  textoDepois String? @db.Text

  /// Só em tipo "texto": o post antes e depois.
  ///
  /// É o que responde, com dado nosso, se trocar o texto trocou o post — e
  /// com ele as curtidas e os comentários. Iguais, a prova social sobreviveu;
  /// diferentes, ficou para trás.
  postAntes  String?
  postDepois String?

  ok   Boolean
  /// A frase da Meta quando deu errado. Nunca carrega token: ver
  /// semSegredo() em cliente-graph.ts.
  erro String?

  /// De onde partiu a ação: "sistema" quando alguém clicou numa tela,
  /// "whatsapp" quando o robô agiu sozinho por causa de uma mensagem no
  /// grupo da loja.
  ///
  /// Existe porque ação de robô precisa ser separável das outras SEM ler o
  /// resto da linha. No dia em que um anúncio aparecer desligado e ninguém
  /// souber por quê, a primeira pergunta é "fui eu ou foi ele?".
  origem String @default("sistema")

  /// Em origem "whatsapp": quem pediu, como dá pra saber de um grupo — nome
  /// e telefone de quem escreveu.
  pedidoPor String?

  /// Em origem "whatsapp": a frase que foi escrita no grupo, inteira.
  ///
  /// Inteira de propósito. Quando alguém reclamar que o carro errado saiu do
  /// ar, a defesa (ou a culpa) está exatamente no que foi escrito, e memória
  /// de ninguém serve pra isso.
  pedidoTexto String? @db.Text

  criadoEm DateTime @default(now())

  @@index([clientId, criadoEm])
  @@index([objetoId, criadoEm])
  @@map("meta_acoes")
}

/// "Já mandei o link do Pix pra essa loja."
///
/// Existe por um motivo bem concreto: a lista do Meta Ads acende vermelho na
/// loja sem saldo, mas não sabia a diferença entre uma loja que ninguém ainda
/// olhou e uma que o gestor já cobrou às oito da manhã. As duas gritavam
/// igual, e vermelho que grita por coisa já resolvida é vermelho que ninguém
/// olha mais.
///
/// Marcar aqui acalma o alerta pelo resto do dia. Se a verba não entrar, ele
/// volta — e volta PIOR que antes, porque agora existe uma promessa que não
/// foi cumprida.
///
/// Não existe "marcar como pago", de propósito: quem diz que a verba entrou é
/// a Meta, não a memória de ninguém. É pra isso que serve o saldo guardado no
/// momento do envio — saldo só desce com gasto, então qualquer subida
/// relevante depois disso é dinheiro que chegou.
model PedidoDeVerba {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  enviadoEm    DateTime @default(now())
  enviadoPorId String?
  enviadoPor   User?    @relation("VerbaPedidaPor", fields: [enviadoPorId], references: [id])

  /// O saldo somado das contas pré-pagas quando o link foi mandado. É a marca
  /// d'água que diz se a verba entrou depois. Vazio quando não deu pra ler o
  /// saldo na hora — aí só o tempo resolve o pedido.
  saldoNoEnvioCents Int?

  /// Preenchido quando o sistema viu o saldo subir. Guardado em vez de
  /// calculado toda vez pra que o histórico não mude de resposta quando a
  /// loja gastar o dinheiro que entrou.
  entrouEm    DateTime?
  entrouCents Int?

  createdAt DateTime @default(now())

  @@index([clientId, enviadoEm])
  @@map("pedidos_de_verba")
}

// Venda registrada pelo gestor (ex: carro vendido): quanto o cliente vendeu e
// quanto foi investido em anúncio pra vender aquilo. Alimenta o relatório
// mensal de vendas e o custo por venda.
model ClientSale {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  description String?
  value       Decimal  @db.Decimal(12, 2)
  adSpend     Decimal  @default(0) @db.Decimal(12, 2)
  soldAt      DateTime @db.Date
  createdById String?
  createdBy   User?    @relation("SaleCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  /// De onde veio o lançamento. Null = gente lançou. "robo-whatsapp" = o robô
  /// registrou a partir do aviso de venda no grupo da loja.
  ///
  /// Existe porque venda sem `createdById` ficaria sem dono: ninguém poderia
  /// apagá-la quando o robô errasse, já que o desfazer é "só a que eu marquei".
  origem String?

  /// Os anúncios do carro vendido (adId, separados por vírgula), quando a venda
  /// veio do robô. É o que impede registrar o MESMO carro duas vezes: o aviso no
  /// grupo pode ser repetido, e cada repetição não pode virar mais uma venda.
  anuncioIds String?

  @@index([clientId, soldAt])
  @@map("client_sales")
}

/// Uma venda que o robô entendeu no grupo mas ainda não pode registrar.
///
/// Só entra no Controle de Vendas venda POR LEAD e COM VALOR, e a frase do grupo
/// ("vendeu o Virtus") quase nunca traz as duas coisas. Então o robô guarda o que
/// já sabe e pergunta o que falta, no próprio grupo.
///
/// Uma por grupo, de propósito: se duas perguntas ficassem abertas, a resposta
/// "68 mil" não saberia a qual das duas pertence.
model VendaAguardandoDados {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  grupoId String @unique

  /// O carro, como está no anúncio, e os adId dele (os gêmeos "Cópia" incluídos).
  carro      String
  anuncioIds String

  /// O que já se sabe. Null = ainda falta.
  valorCents Int?
  origemLead Boolean?

  /// O preço que estava escrito no anúncio, só como DICA na pergunta. Nunca vira
  /// o valor da venda sozinho: preço de anúncio não é preço de venda.
  precoDoAnuncioCents Int?

  textoOriginal String
  quem          String?

  criadoEm DateTime @default(now())
  venceEm  DateTime

  @@map("vendas_aguardando_dados")
}

// Informação fixada no topo da página do cliente (verba, cidade, contato do
// dono, o que a equipe precisar ter sempre à vista).
model ClientPinnedInfo {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label     String
  value     String
  createdAt DateTime @default(now())

  @@index([clientId])
  @@map("client_pinned_info")
}

model ClientAttachment {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileName   String
  url        String
  uploadedAt DateTime @default(now())

  @@map("client_attachments")
}

model ClientHistory {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  note      String
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@map("client_history")
}

// ─── Financeiro ─────────────────────────────────────────────────────────────

enum RevenueStatus {
  PAGO
  PENDENTE
  ATRASADO
}

model Revenue {
  id          String        @id @default(cuid())
  empresa     Empresa       @default(AGENCIA)
  // Entrada sem cliente na carteira existe: o Treinamentos vende curso, não
  // mensalidade de loja, e nem toda entrada da agência nasce de um contrato.
  // Nesses casos quem identifica a entrada é a descrição.
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  description String
  value       Decimal       @db.Decimal(12, 2)
  dueDate     DateTime
  paidDate    DateTime?
  status      RevenueStatus @default(PENDENTE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("revenues")
}

model Expense {
  id             String        @id @default(cuid())
  empresa        Empresa       @default(AGENCIA)
  description    String
  category       String
  value          Decimal       @db.Decimal(12, 2)
  date           DateTime
  responsibleId  String?
  responsible    User?         @relation(fields: [responsibleId], references: [id])
  fixedExpenseId String?
  fixedExpense   FixedExpense? @relation(fields: [fixedExpenseId], references: [id], onDelete: SetNull)
  // Saída fixa nasce não confirmada: só entra no DRE/DFC/lucro depois que o
  // Guilherme confirmar que saiu de verdade. Saída lançada na mão já nasce
  // confirmada, porque só se lança o que já aconteceu.
  paid           Boolean       @default(true)
  paidDate       DateTime?
  /// "robo-whatsapp" quando veio do grupo financeiro; nulo no lançamento da tela.
  origem         String?
  /// A mensagem que lançou: é o que o "desfaz" apaga de uma vez.
  loteId         String?
  createdAt      DateTime      @default(now())

  @@index([empresa, date, paid])
  @@index([loteId])
  @@map("expenses")
}

/// O grupo do WhatsApp onde o dono anota CADA gasto ("financeiro (gastos)").
///
/// Só as mensagens do DONO viram lançamento: os gastos pessoais são dele e de
/// mais ninguém (decisão do Guilherme: "só eu"). Marcado por ADMIN em
/// Configurações → WhatsApp, e nunca pode ser grupo de cliente nem interno.
model GrupoFinanceiro {
  grupoId  String   @id
  nome     String
  donoId   String
  dono     User     @relation("DonoDoGrupoFinanceiro", fields: [donoId], references: [id], onDelete: Cascade)
  criadoEm DateTime @default(now())

  @@index([donoId])
  @@map("grupos_financeiros")
}

/// Gasto pessoal pago com o dinheiro da empresa — no DRE é RETIRADA, não custo.
///
/// Mora fora de `Expense` de propósito: tudo que soma despesa (DRE, análise, o
/// lucro) somaria a retirada como custo da agência. Aqui ela só entra onde deve:
/// como saída de caixa no DFC e como "(−) Retiradas" abaixo do lucro no DRE.
/// O detalhe (mercado, alimentação…) só o dono enxerga.
model GastoPessoal {
  id          String   @id @default(cuid())
  donoId      String
  dono        User     @relation("DonoDoGastoPessoal", fields: [donoId], references: [id], onDelete: Cascade)
  /// De qual caixa o dinheiro saiu.
  empresa     Empresa  @default(AGENCIA)
  description String
  category    String
  value       Decimal  @db.Decimal(12, 2)
  /// Meia-noite UTC do dia da casa, igual a `Expense.date`.
  date        DateTime
  origem      String   @default("sistema")
  loteId      String?
  createdAt   DateTime @default(now())

  @@index([donoId, date])
  @@index([empresa, date])
  @@index([loteId])
  @@map("gastos_pessoais")
}

/// Os gastos que o robô ainda não sabe se são pessoais ou da empresa.
///
/// Um por grupo. Não vence: um gasto sem resposta é dinheiro que saiu, e jogar
/// fora a pergunta seria perder o lançamento. Ele fica até a resposta, e o robô
/// lembra dele a cada mensagem nova.
model PendenciaFinanceira {
  grupoId      String   @id
  itens        Json
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("pendencias_financeiras")
}

/// Os avisos que o robô do financeiro já mandou no grupo, pra nunca mandar o mesmo duas vezes
/// (o agendador pode bater mais de uma vez, e a rota pode ser chamada de fora).
/// chave: "vencimentos:2026-11-22" (um por dia) · "semana:2026-11-16" (um por semana).
model AvisoFinanceiroEnviado {
  grupoId   String
  chave     String
  enviadoEm DateTime @default(now())

  @@id([grupoId, chave])
  @@map("avisos_financeiros_enviados")
}

// Despesas fixas/recorrentes (salários, aluguel, ferramentas...) — igual à
// mensalidade do cliente pro MRR, gera automaticamente o lançamento do mês.
model FixedExpense {
  id          String    @id @default(cuid())
  empresa     Empresa   @default(AGENCIA)
  description String
  category    String
  value       Decimal   @db.Decimal(12, 2)
  dueDay      Int?
  active      Boolean   @default(true)
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("fixed_expenses")
}

// ─── Contratos ──────────────────────────────────────────────────────────────

enum ContractTemplateType {
  TRAFEGO_PAGO
  SITE
  GESTAO_COMPLETA
  OUTRO
}

model ContractTemplate {
  id           String               @id @default(cuid())
  name         String
  type         ContractTemplateType
  bodyTemplate String               @db.Text
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  contracts Contract[]

  @@map("contract_templates")
}

enum ContractStatus {
  RASCUNHO
  AGUARDANDO_ASSINATURA
  ASSINADO
  CANCELADO
}

model Contract {
  id         String           @id @default(cuid())
  clientId   String
  client     Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templateId String
  template   ContractTemplate @relation(fields: [templateId], references: [id])
  content    String           @db.Text
  value      Decimal          @db.Decimal(12, 2)
  status     ContractStatus   @default(RASCUNHO)
  pdfUrl     String?
  sentAt     DateTime?
  signedAt   DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@map("contracts")
}

// ─── Comercial (Pipeline) ───────────────────────────────────────────────────

// Origem antiga do lead. Ficou pro histórico: quem entrou antes do CRM novo
// tem esse campo preenchido. O que vale hoje é o canal.
enum LeadOrigin {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  INDICACAO
  SITE
  TRAFEGO_PAGO
}

// Por onde o lead chegou. É essa divisão que o dashboard usa pra abrir os
// números por canal.
enum LeadChannel {
  META
  PRESENCIAL
  REDE
  MESA_LOJISTA
  ORGANICO
}

// Etapas do funil, na ordem. Batem com os números do dashboard: cada coluna
// que o cartão passa vira uma linha lá.
enum LeadStage {
  LEAD
  QUALIFICADO
  REUNIAO_AGENDADA
  REUNIAO_REALIZADA
  PROPOSTA
  NEGOCIACAO
  FECHADO
  PERDIDO
}

model Lead {
  id          String      @id @default(cuid())
  empresa     Empresa     @default(AGENCIA)
  companyName String
  contactName String
  city        String?
  // UF. Quem chega pelo formulário da landing informa o estado, e sem isso a
  // cidade fica ambígua — tem São Miguel em meio Brasil.
  state       String?
  phone       String?
  origin      LeadOrigin?
  channel     LeadChannel @default(ORGANICO)
  stage       LeadStage   @default(LEAD)
  // Ordem do cartão dentro da coluna — é o que o arrastar pra cima/baixo grava.
  position    Int         @default(0)
  notes       String?
  ownerId     String?
  owner       User?       @relation("LeadOwner", fields: [ownerId], references: [id])

  // Marcos do funil. Guardamos a data de cada passo em vez de só a etapa atual:
  // um lead fechado continua tendo que contar como reunião realizada no mês em
  // que a reunião aconteceu. Voltar o cartão de coluna não apaga o que já foi.
  qualifiedAt   DateTime?
  meetingSetAt  DateTime?
  meetingHeldAt DateTime?
  noShowAt      DateTime?
  proposalAt    DateTime?
  wonAt         DateTime?
  lostAt        DateTime?
  lostReason    String?

  // Fechou: quanto entra por mês, quanto entra de uma vez e por quantos meses.
  monthlyValue   Decimal @default(0) @db.Decimal(12, 2)
  setupValue     Decimal @default(0) @db.Decimal(12, 2)
  contractMonths Int     @default(12)

  // Rastro do anúncio, pra Meta conseguir ligar este lead ao clique que o
  // trouxe. Sem isso a Conversions API manda evento que não casa com ninguém e
  // o anúncio continua otimizando no escuro.
  fbclid          String?
  fbc             String?
  fbp             String?
  landingUrl      String?
  clientIp        String?
  clientUserAgent String?
  // O mesmo id que o Pixel usou no navegador. É ele que faz a Meta entender
  // que o evento do site e o nosso são o mesmo lead, e não dois.
  pixelEventId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleEvent  CommercialEvent?
  metaEvents MetaCapiEvent[]

  @@index([empresa, stage, position])
  @@index([empresa, channel, createdAt])
  @@map("leads")
}

// Cada aviso mandado pra Meta pela Conversions API. Existe porque envio de
// evento é invisível: sem registro, ninguém descobre que parou de funcionar
// até o anúncio começar a otimizar errado. Também segura a repetição — evento
// já enviado com sucesso não vai de novo.
model MetaCapiEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  eventName String
  eventId   String
  sucesso   Boolean  @default(false)
  resposta  String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([leadId, eventName])
  @@index([createdAt])
  @@map("meta_capi_events")
}

// Aparelho que aceitou receber aviso do Legacy OS. É o navegador quem gera o
// endereço e as chaves; guardamos pra conseguir empurrar a notificação depois,
// mesmo com o app fechado. Assinatura que o navegador cancela vira 404/410 no
// envio e é apagada na hora.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

// Cliente tirado da cobrança de UM mês específico. É por mês de propósito: o
// botão do quadro serve pra "esse mês não cobra" (negociação, cortesia, mês
// pulado), não pra desligar o cliente. No mês seguinte ele volta sozinho.
// Pra parar de vez, o caminho é mudar o status em Clientes.
model CobrancaPulada {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month     String // aaaa-mm
  createdAt DateTime @default(now())

  @@unique([clientId, month])
  @@index([month])
  @@map("cobrancas_puladas")
}

// Caixa preta do formulário público: tudo que chegou e NÃO virou lead fica
// aqui, com o corpo cru. Existe porque lead perdido some sem deixar rastro —
// cinco pessoas preencheram, o Pixel contou, e não havia onde olhar. Com isto,
// dá pra ver o que a landing mandou e recuperar o contato na mão.
model LeadRecusado {
  id        String   @id @default(cuid())
  motivo    String
  status    Int
  origem    String?
  ip        String?
  corpo     String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("leads_recusados")
}

// Cada envio do formulário público, guardado só pra segurar o limite por IP.
// Fica no banco em vez de na memória porque na Vercel cada requisição pode cair
// numa instância diferente, e elas reiniciam a cada deploy: contador em memória
// não segura nada de verdade. Linha com mais de um dia é apagada.
model TentativaLead {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@map("tentativas_lead")
}

// Quanto cada canal entregou de impressão e consumiu de verba no mês. É o que
// transforma o funil em custo: sem isso não existe CPL, custo por reunião, CAC.
model ChannelMonth {
  id          String      @id @default(cuid())
  empresa     Empresa     @default(AGENCIA)
  month       String // aaaa-mm
  channel     LeadChannel
  impressions Int         @default(0)
  investment  Decimal     @default(0) @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Cada empresa lança a verba dela: as duas anunciam no mesmo canal no mesmo
  // mês, e somar as duas faria o CPL de cada uma sair errado.
  @@unique([empresa, month, channel])
  @@map("channel_months")
}

// ─── Operações (Tarefas) ────────────────────────────────────────────────────

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  FINALIZADO
}

model Task {
  id          String       @id @default(cuid())
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  title       String
  description String?
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIA)
  status      TaskStatus   @default(PENDENTE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("tasks")
}

// ─── Tráfego Pago ───────────────────────────────────────────────────────────

model Campaign {
