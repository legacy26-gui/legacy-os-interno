  @@map("support_tickets")
}

// ─── Metas da agência ───────────────────────────────────────────────────────

// Saldo de caixa informado manualmente: o sistema não lê o extrato do banco,
// então o acumulado do DFC parte deste valor. Linha única (id fixo "default").
// openingDate é a data exata em que o saldo foi conferido — só entradas e
// saídas posteriores a ela mexem no saldo (as anteriores já estão dentro dele).
model CashSetting {
  id             String   @id @default("default")
  // Saldo inicial é por empresa: o caixa do treinamentos não começa com o
  // dinheiro da agência. Uma linha por empresa, por isso o @unique.
  empresa        Empresa  @unique @default(AGENCIA)
  openingBalance Decimal  @db.Decimal(12, 2)
  openingDate    DateTime @db.Date
  updatedAt      DateTime @updatedAt

  @@map("cash_settings")
}

model MonthlyGoal {
  id               String   @id @default(cuid())
  empresa          Empresa  @default(AGENCIA)
  month            String   // YYYY-MM
  targetRevenue    Decimal  @db.Decimal(12, 2)
  targetSalesQty   Int?
  targetSalesValue Decimal? @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Cada empresa tem a meta dela pro mesmo mês — a agência pode querer 50 mil
  // em outubro e o treinamentos 12 mil, e as duas linhas convivem.
  @@unique([empresa, month])
  @@map("monthly_goals")
}

// ─── Gestão de Contas (agências de tráfego) ─────────────────────────────────

model DailyReview {
  id         String   @id @default(cuid())
