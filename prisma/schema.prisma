model WeeklyReview {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reviewerId String?
  reviewer   User?    @relation("WeeklyReviewer", fields: [reviewerId], references: [id])

  // Semana do mês (1 a 5) e mês de referência (AAAA-MM) a que a revisão se
  // refere. Guardados explicitamente pra que preencher com atraso — inclusive
  // depois de virar o mês — não jogue a revisão na semana errada.
  weekOfMonth Int?
  refMonth    String?

  paymentCleared        Boolean @default(false)
  reportGenerated       Boolean @default(false)
  checkedBestCampaigns  Boolean @default(false)
  checkedWeeklyCost     Boolean @default(false)
  definedNewCreatives   Boolean @default(false)
  definedNewCampaigns   Boolean @default(false)

  reportPhotoUrl  String? @db.Text // foto do relatório (obrigatória no formulário)

